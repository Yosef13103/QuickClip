<UserControl x:Class="QuickClip.Views.GamesSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:QuickClip.Controls"
             Background="Transparent" PreviewMouseWheel="SourceList_PreviewMouseWheel">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuickClip;component/Themes/Styles.xaml" />
                <ResourceDictionary Source="/QuickClip;component/Themes/StoreLogos.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="GameHeadingButton" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="10,7" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="HeadingSurface" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HeadingSurface" Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="HeadingSurface" Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="HeadingSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="StoreTile" TargetType="ToggleButton">
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="TileSurface" Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="9">
                                <Grid Margin="5,14,5,5">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Path x:Name="Logo" Style="{StaticResource StoreLogo}" Fill="{DynamicResource PrimaryTextBrush}"
                                          Opacity=".36" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,3" />
                                    <TextBlock x:Name="StoreName" Grid.Row="1" Text="{Binding TileName}" TextAlignment="Center"
                                               TextWrapping="Wrap" FontSize="{DynamicResource QuickClipText12}" Foreground="{DynamicResource SubtleTextBrush}"
                                               Margin="0,0,0,3" />
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                                        <Ellipse x:Name="StateDot" Width="5" Height="5" Fill="{DynamicResource SubtleTextBrush}" Margin="0,0,4,0" VerticalAlignment="Center" />
                                        <TextBlock x:Name="StateLabel" Text="Disabled" Foreground="{DynamicResource SubtleTextBrush}" FontSize="{DynamicResource QuickClipText11}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="TileSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="Logo" Property="Opacity" Value="1" />
                                    <Setter TargetName="StoreName" Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                    <Setter TargetName="StateDot" Property="Fill" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="StateLabel" Property="Text" Value="Enabled" />
                                    <Setter TargetName="StateLabel" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="TileSurface" Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="TileSurface" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
                                    <Setter TargetName="TileSurface" Property="BorderThickness" Value="2" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="TileSurface" Property="Opacity" Value=".55" />
                                    <Setter TargetName="StateLabel" Property="Text" Value="Unavailable" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="StoreRefresh" TargetType="Button">
                <Setter Property="Width" Value="23" />
                <Setter Property="Height" Value="23" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="RefreshSurface" Background="Transparent" CornerRadius="5">
                                <Path x:Name="RefreshGlyph" Width="12" Height="12" Stretch="Uniform"
                                      Stroke="{DynamicResource SubtleTextBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Data="M 11,4 A 5,5 0 1 0 12,8 M 11,1 L 11,4 L 8,4"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RefreshSurface" Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
                                    <Setter TargetName="RefreshGlyph" Property="Stroke" Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="RefreshSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="RefreshSurface" Property="BorderThickness" Value="1" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="RefreshGlyph" Property="Opacity" Value=".28" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <BooleanToVisibilityConverter x:Key="ShowManualActions" />
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Margin="20,12,26,12">
            <TextBlock Text="Apps" FontSize="{DynamicResource QuickClipText24}"
                       FontWeight="SemiBold" Margin="0,0,0,4" />
            <TextBlock Text="Apps capture moments based on your settings. When you're playing a game, QuickClip records the game instead."
                       Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <ItemsControl x:Name="Applications" AutomationProperties.Name="Recording applications">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="ApplicationSettings_Click" Tag="{Binding Id}" ToolTip="{Binding Tooltip}"
                                AutomationProperties.Name="{Binding ActionLabel}"
                                Width="370" Height="80" Padding="0" Margin="0,0,10,0" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Card" Background="{DynamicResource PanelBrush}"
                                            BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1"
                                            CornerRadius="10" Padding="12,9">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Card" Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Grid Width="342" Height="58">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="48" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="44" Height="44" CornerRadius="9"
                                        Background="{DynamicResource ElevatedSurfaceBrush}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center">
                                    <Path Data="{Binding Icon}" Fill="{Binding IconBrush}"
                                          Width="32" Height="28" Stretch="Uniform"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,10,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               FontSize="{DynamicResource QuickClipText15}" />
                                    <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                               FontSize="{DynamicResource QuickClipText11}"
                                               Foreground="{DynamicResource SubtleTextBrush}" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="2" VerticalAlignment="Center"
                                            HorizontalAlignment="Right">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Ellipse Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource SubtleTextBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Enabled}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding Status}"
                                                   FontSize="{DynamicResource QuickClipText11}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE713;"
                                               FontSize="14" Foreground="{DynamicResource SecondaryTextBrush}"
                                               HorizontalAlignment="Right" Margin="0,6,0,0"
                                               ToolTip="Open recording settings" />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <TextBlock Grid.Row="1" Text="Games" FontSize="{DynamicResource QuickClipText24}"
                   FontWeight="SemiBold" Margin="20,4,26,7" />
        <!-- Search is deliberately outside the virtualized ListBox. Changing its
             collection view must never recycle the focused search TextBox. -->
        <DockPanel Grid.Row="2" Margin="20,0,26,8" KeyboardNavigation.TabNavigation="Continue">
            <TextBlock DockPanel.Dock="Left" Text="Search games" VerticalAlignment="Center"
                       Margin="0,0,10,0" />
            <TextBox x:Name="Search" AutomationProperties.Name="Search games by name or executable"
                     TextChanged="Search_Changed" />
        </DockPanel>
        <ListBox x:Name="Games" Grid.Row="3" Margin="0" Padding="20,10,14,12" HorizontalContentAlignment="Stretch"
                 Background="Transparent" BorderThickness="0" AutomationProperties.Name="Games catalog"
                 ScrollViewer.CanContentScroll="True" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                 VirtualizingPanel.ScrollUnit="Pixel">
        <ListBox.ItemsSource>
            <CompositeCollection>
                <ListBoxItem Focusable="False" HorizontalContentAlignment="Stretch" Padding="0" Background="Transparent">
                  <StackPanel Margin="0,6,12,0">
        <Border Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="20,8,20,18" Margin="0,0,14,14">
        <StackPanel>
            <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="AutoScan" Content="Automatically discover installed games" Click="AutoScan_Click" Margin="0,8,0,0" />
            <TextBlock x:Name="ScanHelp" TextWrapping="Wrap" Style="{StaticResource Hint}" Visibility="Collapsed" />
            <StackPanel x:Name="LibrarySources">
            <Expander Header="Game stores" Margin="0,6,0,6">
                <StackPanel>
                    <Button Content="Enable all supported game stores" Click="EnableStores_Click" HorizontalAlignment="Left" Margin="0,4,0,6" />
                    <TextBlock Text="Click a store to enable or disable discovery. Refresh rescans only that store."
                               Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,5" />
                    <ItemsControl x:Name="Launchers" AutomationProperties.Name="Game stores">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid MinWidth="96" MinHeight="96" Width="100" Margin="3">
                                    <ToggleButton Style="{StaticResource StoreTile}" IsChecked="{Binding Enabled, Mode=OneWay}"
                                                  IsEnabled="{Binding Supported}" Click="Provider_Click"
                                                  ToolTip="{Binding TileTooltip}" AutomationProperties.Name="{Binding Name}" />
                                    <Button Style="{StaticResource StoreRefresh}" Click="RefreshLauncher_Click" IsEnabled="{Binding CanRefresh}"
                                            ToolTip="{Binding RefreshName}" ToolTipService.ShowOnDisabled="True"
                                            AutomationProperties.Name="{Binding RefreshName}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </Expander>
            <Expander x:Name="IgnoredExecutables" Header="Blocked executables" Margin="0,0,0,6">
                <StackPanel>
                    <TextBlock Text="Block an exact executable path from automatic game detection. Restore it here to apply its usual catalog rules." Style="{StaticResource Hint}" />
                    <ListBox x:Name="BlockedFiles" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Blocked executables" />
                    <WrapPanel Margin="0,4,0,0">
                        <Button Content="Block executables…" Click="BlockFile_Click" Margin="0,0,6,4" />
                        <Button Content="Restore selected executable" Click="RestoreFile_Click" Margin="0,0,0,4" />
                    </WrapPanel>
                    <TextBlock x:Name="BlockedError" Style="{StaticResource Hint}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Expander>
                </StackPanel>
            <WrapPanel Margin="0,4,0,0">
                <Button x:Name="ScanButton" Content="Scan Now" Click="Scan_Click" Margin="0,0,6,0" />
                <Button x:Name="CancelButton" Content="Pause scan" Click="Cancel_Click" IsEnabled="False" Margin="0,0,6,0" />
                <Button Content="Add Game…" Click="Add_Click" Margin="0,0,6,0" />
            </WrapPanel>
            <TextBlock Text="Add one game by its executable or installation folder, or add a collection containing several separate games."
                       Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0" />
            <Expander x:Name="AddedFolders" Header="Game folders and collections" Margin="0,6,0,4">
                <StackPanel>
                    <TextBlock Text="Remove a source from QuickClip without deleting any game files." Style="{StaticResource Hint}" TextWrapping="Wrap" />
                    <ListBox x:Name="Roots" Background="Transparent" BorderThickness="0" ScrollViewer.VerticalScrollBarVisibility="Disabled" AutomationProperties.Name="Game folders">
                        <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style></ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate><DataTemplate><DockPanel Margin="2">
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchCheckBox}" IsChecked="{Binding Enabled, Mode=OneWay}" IsEnabled="{Binding CanToggle}" Click="RootEnabled_Click" VerticalAlignment="Center" AutomationProperties.Name="Enable game folder" />
                            <WrapPanel DockPanel.Dock="Right">
                                <Button Content="Refresh" Click="RefreshSource_Click" IsEnabled="{Binding CanRefresh}" Margin="0,0,4,0" />
                                <Button Content="{Binding RemoveLabel}" Click="RemoveRoot_Click" Margin="0,0,4,0" />
                                <Button Content="Restore previous exclusion…" Click="RestoreCollectionExclusion_Click"
                                        Visibility="{Binding HasPreviousExclusion, Converter={StaticResource ShowManualActions}}"
                                        ToolTip="Restore this folder's earlier game-level exclusion; other blocks remain in effect." Margin="0,0,4,0" />
                            </WrapPanel>
                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0" />
                        </DockPanel></DataTemplate></ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="SourceError" Style="{StaticResource Hint}" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />

                </StackPanel>
            </Expander>
            <TextBlock x:Name="AddError" Style="{StaticResource Hint}" Foreground="{DynamicResource DangerBrush}"
                       TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
            <TextBlock x:Name="Status" Style="{StaticResource Hint}" Margin="0,6,0,0" TextWrapping="Wrap"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="TargetingHelp" TextWrapping="Wrap" Style="{StaticResource Hint}" Visibility="Collapsed" />
            <Expander x:Name="ScanDetails" Header="Scan details and recording scope" Margin="0,2,0,2">
                <StackPanel>
                    <TextBlock x:Name="LastScan" Style="{StaticResource Hint}" />
                    <ListBox x:Name="ScanIssues" ScrollViewer.VerticalScrollBarVisibility="Disabled" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Last scan issues" />
                    <TextBlock Text="Targeting rules apply to game detection. Manual entire-display capture includes anything visible on the approved display, including games disabled here." Style="{StaticResource Hint}" />
                    <TextBlock x:Name="DiscoveryCountDetail" Style="{StaticResource Hint}" TextWrapping="Wrap"
                               ToolTip="A retained game may also be awaiting verification." />
                </StackPanel>
            </Expander>
            <TextBlock x:Name="Count" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,10,0,0" />

                        </StackPanel>
                        </Border>
                  </StackPanel>
                </ListBoxItem>
                <CollectionContainer x:Name="AttentionHeading" />
                <CollectionContainer x:Name="AttentionItems" />
                <CollectionContainer x:Name="IgnoredHeading" />
                <CollectionContainer x:Name="IgnoredItems" />
                <CollectionContainer x:Name="OtherGamesHeading" />
                <CollectionContainer x:Name="GameItems" />
            </CompositeCollection>
        </ListBox.ItemsSource>
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MaxWidth" Value="1340" />
                    <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border Background="Transparent" Padding="0" BorderThickness="1" BorderBrush="Transparent" x:Name="RowFocus" CornerRadius="8">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsKeyboardFocused" Value="True">
                                        <Setter TargetName="RowFocus" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Margin="2,4" Padding="8" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="9">
                    <StackPanel>
                        <DockPanel>
                            <CheckBox DockPanel.Dock="Right" Style="{StaticResource SwitchCheckBox}" Click="Capture_Click"
                                      IsChecked="{Binding CaptureEnabled, Mode=OneWay}"
                                      VerticalAlignment="Center" Margin="8,0,4,0"
                                      AutomationProperties.Name="{Binding CaptureAction}"
                                      ToolTip="{Binding CaptureAction}" />
                            <ToggleButton Style="{StaticResource GameHeadingButton}" IsChecked="{Binding IsExpanded, Mode=OneWay}"
                                          HorizontalAlignment="Stretch" Click="Details_Click" AutomationProperties.Name="{Binding DetailsAction}"
                                          AutomationProperties.HelpText="{Binding Summary}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Chevron}" Margin="10,0,0,0"
                                               VerticalAlignment="Center" FontFamily="{StaticResource IconFont}" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Entry.DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasIssue}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IssueIsBlocking}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DockPanel>
                            </ToggleButton>
                        </DockPanel>
                        <controls:AnimatedReveal IsExpanded="{Binding IsExpanded}">
                            <StackPanel Margin="12,6,12,8">
                                <StackPanel Margin="0,0,0,6" Visibility="{Binding HasIssue, Converter={StaticResource ShowManualActions}}">
                                    <TextBlock Text="{Binding IssueReason}" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding IssueImpact}" Style="{StaticResource Hint}" />
                                    <TextBlock Text="{Binding IssueTechnicalDetail}" Style="{StaticResource Hint}"
                                               Visibility="{Binding ShowAdvanced, Converter={StaticResource ShowManualActions}}" />
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Content="{Binding IssueRepairLabel}" Click="RepairIssue_Click" Margin="0,0,6,4" />
                                        <Button Content="{Binding DismissIssueLabel}" Click="DismissIssue_Click" Margin="0,0,6,4" />
                                    </WrapPanel>
                                </StackPanel>
                                <WrapPanel>
                                    <Button Content="Rename…" Click="Rename_Click" Margin="0,0,6,4" />
                                    <Button Content="Clip folders..." Click="GameCollections_Click" Margin="0,0,6,4"
                                            ToolTip="Choose a folder for future clips (optional)." />
                                    <Button Content="Edit executables…" Click="Edit_Click" Margin="0,0,6,4" />
                                    <Button Content="Remove manual entry" Click="Remove_Click" Margin="0,0,6,4"
                                            Visibility="{Binding IsManual, Converter={StaticResource ShowManualActions}}" />
                                </WrapPanel>
                                <TextBlock Text="{Binding ActionError}" Style="{StaticResource Hint}" Foreground="{DynamicResource DangerBrush}"
                                           TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                                <TextBlock Text="{Binding Inheritance}" Style="{StaticResource Hint}" Margin="0,4" />
                                <StackPanel Margin="0,4,0,2"
                                            Visibility="{Binding ShowAdvanced, Converter={StaticResource ShowManualActions}}">
                                        <TextBlock Text="Game files" FontWeight="SemiBold" />
                                        <TextBlock Text="Game files can start recording. Launcher and blocked files cannot." Style="{StaticResource Hint}" Margin="0,6,0,4" />
                                        <ComboBox x:Name="ExecutableList" ItemsSource="{Binding Executables}" SelectedValuePath="Path" SelectedValue="{Binding SelectedExecutable, Mode=TwoWay}"
                                                  AutomationProperties.Name="Game files" Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource PrimaryTextBrush}" BorderBrush="{DynamicResource BorderBrush}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <WrapPanel>
                                            <Button Content="Detach executable" Click="DetachExecutable_Click"
                                                  CommandParameter="{Binding SelectedValue, ElementName=ExecutableList}"
                                                  IsEnabled="{Binding SelectedItem.CanDetach, ElementName=ExecutableList, FallbackValue=False}"
                                                  Margin="0,4,6,0" />
                                              <Button Content="Toggle launcher role" Click="Launcher_Click"
                                                CommandParameter="{Binding SelectedValue, ElementName=ExecutableList}"
                                                HorizontalAlignment="Left" Margin="0,4,6,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedValue, ElementName=ExecutableList}" Value="{x:Null}">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="{Binding SelectedItem.BlockAction, ElementName=ExecutableList, FallbackValue=Block selected executable, TargetNullValue=Block selected executable}" Click="BlockSelected_Click"
                                                CommandParameter="{Binding SelectedValue, ElementName=ExecutableList}"
                                                Margin="0,4,0,0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedValue, ElementName=ExecutableList}" Value="{x:Null}">
                                                            <Setter Property="IsEnabled" Value="False" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </controls:AnimatedReveal>
                    </StackPanel>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
    </ListBox>
    </Grid>
</UserControl>
