<UserControl x:Class="QuickClip.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Loaded_View" Unloaded="Unloaded_View" IsVisibleChanged="Visibility_Changed">
    <UserControl.Resources>
        <ResourceDictionary Source="/QuickClip;component/Themes/Styles.xaml" />
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <CheckBox x:Name="EnabledBox" Content="Collect diagnostic events for this session"
                  Checked="Enabled_Changed" Unchecked="Enabled_Changed"/>
        <TextBlock Grid.Row="1" Margin="0,4,0,12" TextWrapping="Wrap"
                   Text="For troubleshooting. Collecting events uses memory and CPU. Turning it off clears the history. Copy and export use the current filters. Review the output before sharing."/>
        <WrapPanel Grid.Row="2" Margin="0,0,0,8">
            <ComboBox x:Name="Categories" Width="152" Margin="0,0,8,4"
                      AutomationProperties.Name="Diagnostic category" SelectionChanged="Filter_Changed"/>
            <CheckBox x:Name="ErrorsOnly" Content="Errors only" Margin="0,0,8,4" VerticalAlignment="Center"
                      Checked="Filter_Changed" Unchecked="Filter_Changed"/>
            <TextBox x:Name="Search" Width="160" Margin="0,0,8,4" MaxLength="200"
                     AutomationProperties.Name="Search diagnostic events" TextChanged="Filter_Changed"/>
            <Button x:Name="CopyButton" Content="Copy results" Margin="0,0,8,4" Click="Copy_Click"/>
            <Button x:Name="ExportButton" Content="Export…" Margin="0,0,0,4" Click="Export_Click"/>
        </WrapPanel>
        <ListBox x:Name="Results" Grid.Row="3" MinHeight="160" MaxHeight="400"
                 AutomationProperties.Name="Diagnostic events"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" VirtualizingPanel.VirtualizationMode="Recycling"/>
        <TextBlock x:Name="Status" Grid.Row="4" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
