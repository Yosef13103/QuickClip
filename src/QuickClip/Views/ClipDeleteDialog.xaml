<Window x:Class="QuickClip.Views.ClipDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete clips" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Window.Resources>
        <ResourceDictionary Source="/QuickClip;component/Themes/Styles.xaml" />
    </Window.Resources>
    <StackPanel Margin="24">
        <TextBlock x:Name="Heading" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="Files" Margin="0,12" TextWrapping="Wrap" />
        <TextBlock Text="You can restore these files from the Windows Recycle Bin. Projects referring to them may need them restored."
                   Foreground="{StaticResource SubtleText}" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="CancelButton" Content="Cancel" IsCancel="True" IsDefault="True" MinWidth="90" />
            <Button Content="Delete" Background="#B42332" Foreground="White" Click="Delete_Click" MinWidth="90" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</Window>
