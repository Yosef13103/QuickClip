<UserControl x:Class="QuickClip.Views.SettingsView" xmlns:controls="clr-namespace:QuickClip.Controls" xmlns:views="clr-namespace:QuickClip.Views"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuickClip;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource PanelBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20,8,20,18" />
                <Setter Property="Margin" Value="0,0,14,14" />
            </Style>
            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,10,0,4" />
            </Style>
            <!-- Clear visual hierarchy: master switch lives in Recording, never beside Save Clip. -->
            <Style x:Key="ReplayMasterControl" TargetType="CheckBox">
                <Setter Property="Focusable" Value="True" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="AutomationProperties.Name" Value="Enable instant replay" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="MasterCard" Background="#25272B" BorderBrush="#454A51"
                                    BorderThickness="1" CornerRadius="9" Padding="15,13">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Game and desktop capture" FontWeight="SemiBold" FontSize="15"
                                                   Foreground="#F3F4F6" />
                                        <TextBlock Text="Enable instant replay for recognized games"
                                                   FontSize="12" Foreground="#AEB4BC" Margin="0,5,10,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Grid Grid.Column="1" Width="48" Height="26" VerticalAlignment="Center">
                                        <Border x:Name="SwitchTrack" CornerRadius="13" Background="#4D5561" />
                                        <Ellipse x:Name="SwitchThumb" HorizontalAlignment="Left" Margin="4,0,0,0"
                                                 VerticalAlignment="Center" Width="18" Height="18" Fill="#F5F6F8" />
                                    </Grid>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="SwitchTrack" Property="Background" Value="#168F87" />
                                    <Setter TargetName="SwitchThumb" Property="HorizontalAlignment" Value="Right" />
                                    <Setter TargetName="SwitchThumb" Property="Margin" Value="0,0,4,0" />
                                    <Setter TargetName="MasterCard" Property="BorderBrush" Value="#287E79" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="MasterCard" Property="Background" Value="#2C3035" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="MasterCard" Property="BorderBrush" Value="#81CAC3" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="MasterCard" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Row" TargetType="Grid">
                <Setter Property="Margin" Value="0,10,0,0" />
            </Style>
            <Style x:Key="EndpointPlaceholder" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="12,0,30,0" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="-1">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Settings' vertical section rail sits beside the application's primary navigation. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SectionsColumn" Width="176" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{StaticResource RailBrush}" Padding="8,16,8,16">
            <!-- Left navigation uses comfortable centered spacing; shrink/scroll when DPI requires. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch">
                <StackPanel x:Name="SettingsSections" KeyboardNavigation.DirectionalNavigation="Cycle"
                            VerticalAlignment="Center">
                    <StackPanel.Resources>
                        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                            <Setter Property="GroupName" Value="SettingsSection" />
                            <Setter Property="Foreground" Value="#C9CDD2" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Focusable" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="RailButton" Background="Transparent" CornerRadius="7"
                                                BorderThickness="1" BorderBrush="Transparent" Padding="9,9" Margin="0,3">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="3" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="SelectedAccent" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                        CornerRadius="2" Visibility="Collapsed" />
                                                <DockPanel Grid.Column="1" LastChildFill="True" Margin="11,0,0,0">
                                                    <TextBlock Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}"
                                                               FontSize="16" Width="25" VerticalAlignment="Center" />
                                                    <ContentPresenter ContentSource="Content" VerticalAlignment="Center"
                                                                      RecognizesAccessKey="True" />
                                                </DockPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RailButton" Property="Background" Value="#2B2D30" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="RailButton" Property="Background" Value="#31373B" />
                                                <Setter TargetName="SelectedAccent" Property="Visibility" Value="Visible" />
                                                <Setter Property="Foreground" Value="White" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="RailButton" Property="BorderBrush" Value="#83BEDD" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <EventSetter Event="Checked" Handler="SettingsSection_Changed" />
                        </Style>
                    </StackPanel.Resources>
                    <RadioButton x:Name="RecordingSection" Content="Recording" Tag="&#xE714;" IsChecked="True" />
                    <RadioButton x:Name="AudioSection" Content="Audio" Tag="&#xE767;" />
                    <RadioButton x:Name="GamesSection" Content="Games" Tag="&#xE7FC;" />
                    <RadioButton x:Name="HotkeysSection" Content="Hotkeys" Tag="&#xE765;" />
                    <RadioButton x:Name="SharingSection" Content="Sharing" Tag="&#xE72D;" />
                    <RadioButton x:Name="LibrarySection" Content="Library" Tag="&#xE8B7;" />
                    <RadioButton x:Name="GeneralSection" Content="General" Tag="&#xE713;" />
                    <RadioButton x:Name="DiagnosticsSection" Content="Diagnostics" Tag="&#xE9CE;" />
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Grid Grid.Column="1">
        <views:GamesSettingsView x:Name="GamesPage" Visibility="Collapsed" />
        <ScrollViewer x:Name="GeneralPage" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="SettingsContent" MaxWidth="1340" Margin="28,22,14,28" HorizontalAlignment="Center">
            <TextBlock x:Name="SectionTitle" Text="Settings" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,16" />

            <TextBlock x:Name="PersonalProfileHint" Style="{StaticResource Hint}" Visibility="Collapsed"
                       TextWrapping="Wrap" Margin="0,0,0,14" />

            <controls:ResponsiveCards>
            <!-- Updates -->
            <Border x:Name="UpdatesCard" Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,10,0,0">
                        <Button x:Name="CheckUpdatesButton" DockPanel.Dock="Right" Style="{StaticResource TextButton}" Margin="0" VerticalAlignment="Center"
                                Click="CheckUpdates_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="Check for updates" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Margin="0,0,8,0" VerticalAlignment="Center"
                                Click="ThisVersionNotes_Click" ToolTip="The release notes of the version you have">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE789;" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="What's new" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="Updates" Style="{StaticResource CardTitle}" Margin="0,0,0,2" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="UpdateStatusText" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <StackPanel x:Name="UpdateActions" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                        <Button x:Name="InstallUpdateButton" Style="{DynamicResource AccentButtonStyle}" Padding="12,5" Focusable="False" Click="InstallUpdate_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="Install and restart" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TextButton}" Content="What's new" Margin="8,0,0,0" Click="WhatsNew_Click" />
                    </StackPanel>
                    <ProgressBar x:Name="UpdateProgress" Height="6" Margin="0,12,0,0" Maximum="1" Visibility="Collapsed" />
                    <Grid Style="{StaticResource Row}" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Channel" VerticalAlignment="Center" />
                        <ComboBox x:Name="ChannelCombo" Grid.Column="1" SelectionChanged="Channel_Changed" />
                    </Grid>
                    <TextBlock x:Name="ChannelHint" Style="{StaticResource Hint}" Margin="160,4,0,0" TextWrapping="Wrap" />
                    <CheckBox x:Name="AutoUpdateCheck" Content="Check for updates automatically when QuickClip starts" Margin="0,12,0,0"
                              Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed" />
                </StackPanel>
            </Border>

            <!-- Recording -->
            <Border x:Name="RecordingCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Instant replay" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="QuickClip keeps the last few minutes of your screen in memory; press the hotkey to save them as a clip. Nothing is written to disk until you do." />
                    <CheckBox x:Name="RecordingCheck" Style="{StaticResource ReplayMasterControl}" Margin="0,14,0,2" Checked="Changed" Unchecked="Changed" />

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="MonitorLabel" Text="Monitor" VerticalAlignment="Center" />
                        <ComboBox x:Name="MonitorCombo" Grid.Column="1" SelectionChanged="Changed" />
                    </Grid>

                    <TextBlock x:Name="RecordingSourceLabel" Text="Recording source" Margin="0,12,0,4" />
                    <ComboBox x:Name="SourceCombo" SelectionChanged="Changed" AutomationProperties.Name="Recording source">
                        <ComboBoxItem x:Name="GameSourceItem" Content="Automatic - Game First" />
                        <ComboBoxItem x:Name="DisplaySourceItem" Content="Selected monitor" />
                    </ComboBox>
                    <TextBlock x:Name="CaptureTargetHint" Style="{StaticResource Hint}" Margin="0,6,0,4" TextWrapping="Wrap" />
                    <Button x:Name="GameDisplayConsent" Visibility="Collapsed" HorizontalAlignment="Left"
                            Margin="0,4,0,0" Click="GameDisplayConsent_Click" />
                    <Button x:Name="ManualDesktopButton" Visibility="Collapsed" HorizontalAlignment="Left"
                            Margin="0,8,0,0" Click="ManualDesktop_Click" />

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Capture area" VerticalAlignment="Center" />
                        <ComboBox x:Name="AreaCombo" Grid.Column="1" SelectionChanged="Changed"
                                  AutomationProperties.Name="Capture area" />
                    </Grid>
                    <Expander Header="Custom aspect ratio" Margin="0,4,0,0">
                        <StackPanel Margin="0,4,0,6">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Apply ratio" Click="ApplyAspect_Click" Margin="8,0,0,0" />
                                <TextBox x:Name="CustomAspectBox" MaxLength="24" ToolTip="Enter a ratio like 32:9"
                                         AutomationProperties.Name="Custom aspect ratio" TextChanged="CustomAspect_Changed" />
                            </DockPanel>
                            <TextBlock x:Name="CustomAspectHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Expander>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Output resolution" VerticalAlignment="Center" />
                        <ComboBox x:Name="ResolutionCombo" Grid.Column="1" SelectionChanged="Changed"
                                  AutomationProperties.Name="Output resolution" />
                    </Grid>
                    <Expander Header="Custom output size" Margin="0,4,0,0">
                        <StackPanel Margin="0,4,0,6">
                            <TextBlock Text="Width × height in pixels" Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CustomWidthBox" MaxLength="10" ToolTip="Output width in pixels"
                                         AutomationProperties.Name="Output width" TextChanged="CustomDimension_Changed" />
                                <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" Margin="8,0" />
                                <TextBox x:Name="CustomHeightBox" Grid.Column="2" MaxLength="10" ToolTip="Output height in pixels"
                                         AutomationProperties.Name="Output height" TextChanged="CustomDimension_Changed" />
                            </Grid>
                            <CheckBox x:Name="LockOutputRatio" IsChecked="True" Margin="0,6,0,0">
                                <TextBlock Text="Match capture area when editing one dimension" TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock x:Name="CustomSizeHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <WrapPanel Margin="0,4,0,0">
                                <Button x:Name="ApplySizeButton" Content="Apply size" Click="ApplySize_Click" Margin="0,0,8,0" />
                                <Button x:Name="CropToFitButton" Content="Crop to fit" Click="CropToFit_Click" Margin="0,0,8,0" />
                                <Button Content="Reset fields" Click="ResetSize_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Expander>
                    <Border Background="#14171C" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock x:Name="PreviewHeading" Text="Selected monitor preview" FontWeight="SemiBold" />
                            <controls:RecordingAreaPreview x:Name="CropPreview" Height="100" Margin="4,8" Focusable="False" />
                            <TextBlock x:Name="PreviewDimensions" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="PreviewHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <Button x:Name="UseNativeButton" Content="Use Native for every source" Click="UseNative_Click"
                                    HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Clip length" VerticalAlignment="Center" />
                        <Slider x:Name="BufferSlider" Grid.Column="1" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                TickPlacement="BottomRight" VerticalAlignment="Center" ValueChanged="Changed" Focusable="False" />
                        <TextBlock x:Name="BufferText" Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0" FontWeight="SemiBold" />
                    </Grid>
                    <TextBlock x:Name="RamText" Margin="160,4,0,0" Style="{StaticResource Hint}" />

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Quality" VerticalAlignment="Center" />
                        <ComboBox x:Name="QualityCombo" Grid.Column="1" SelectionChanged="Changed" />
                        <TextBlock x:Name="BitrateText" Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0" Style="{StaticResource Hint}" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Frame rate" VerticalAlignment="Center" />
                        <ComboBox x:Name="FpsCombo" Grid.Column="1" SelectionChanged="Changed" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Encoder" VerticalAlignment="Center" />
                        <ComboBox x:Name="EncoderCombo" Grid.Column="1" SelectionChanged="Changed" AutomationProperties.Name="Recording encoder">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="IsEnabled" Value="{Binding Enabled}" />
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,5" /></DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ComboBox.GroupStyle>
                        </ComboBox>
                    </Grid>

                    <CheckBox x:Name="CursorCheck" Content="Show the mouse pointer" Margin="160,12,0,0" Checked="Changed" Unchecked="Changed" />
                    <TextBlock x:Name="RecorderStatus" Margin="0,12,0,0" Style="{StaticResource Hint}" />
                    <TextBlock Text="NVENC performance preset" Margin="0,12,0,4" />
                    <ComboBox x:Name="NvencPresetCombo" SelectionChanged="Changed" AutomationProperties.Name="NVENC performance preset" />
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                               Text="P2 reduces encoder work. P3 and P4 can improve compression efficiency at the same bitrate. Game FPS and visual quality depend on the workload." />
                    <Expander Header="Advanced monitor backend" Margin="0,12,0,0">
                        <StackPanel Margin="0,8,0,0">
                            <ComboBox x:Name="BackendCombo" SelectionChanged="Changed" AutomationProperties.Name="Monitor capture backend" />
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                       Text="Desktop Duplication records everything visible on the selected display, including windows covering the game, and avoids the Windows capture indicator. Windows Graphics Capture may show an indicator. This preference applies to monitor capture. Game-window capture always uses Windows Graphics Capture." />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>
            <Border x:Name="DiagnosticsCard" Style="{StaticResource Card}">
                    <Expander x:Name="CaptureAdvanced" Header="Advanced Recording Diagnostics" Margin="0,12,0,0" Expanded="Diagnostics_Expanded">
                        <StackPanel Margin="0,10,0,0">
                            <CheckBox x:Name="DiagnosticsCheck" Content="Sample recording timings (every 5 seconds)" Margin="0,10,0,0" Checked="Changed" Unchecked="Changed" />
                            <TextBox x:Name="CaptureDiagnostics" IsReadOnly="True" TextWrapping="Wrap" Margin="0,10,0,0" />
                            <Button Content="Refresh diagnostics" Click="Diagnostics_Refresh" HorizontalAlignment="Left" Margin="0,8,0,0" />
                        </StackPanel>
                    </Expander>
            </Border>

            <!-- Audio -->
            <Border x:Name="AudioCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Audio" Style="{StaticResource CardTitle}" />
                    <CheckBox x:Name="EndpointModeCheck" Content="Record selected Windows audio devices"
                              Margin="0,8,0,0" Checked="EndpointMode_Changed" Unchecked="EndpointMode_Changed" />
                    <StackPanel x:Name="EndpointPanel" Visibility="Collapsed" Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                   Text="Each enabled device gets its own track. With no devices enabled, the clip is video only. Changing these settings restarts the replay buffer." />
                        <TextBlock Text="Playback (what you hear)" Style="{StaticResource SectionHeader}" />
                        <DockPanel>
                            <Button x:Name="AddPlaybackButton" DockPanel.Dock="Right" Content="Add playback" Margin="8,0,0,0"
                                    Click="AddEndpoint_Click" />
                            <Grid>
                                <ComboBox x:Name="PlaybackPicker" SelectionChanged="EndpointPicker_Changed"
                                          AutomationProperties.Name="Playback device" />
                                <TextBlock x:Name="PlaybackPlaceholder" Style="{StaticResource EndpointPlaceholder}"
                                           Tag="{Binding SelectedIndex, ElementName=PlaybackPicker}" Text="Choose a playback device" />
                            </Grid>
                        </DockPanel>
                        <TextBlock Text="Microphones (input)" Style="{StaticResource SectionHeader}" />
                        <DockPanel>
                            <Button x:Name="AddMicrophoneButton" DockPanel.Dock="Right" Content="Add microphone" Margin="8,0,0,0"
                                    Click="AddEndpoint_Click" />
                            <Grid>
                                <ComboBox x:Name="MicrophonePicker" SelectionChanged="EndpointPicker_Changed"
                                          AutomationProperties.Name="Microphone input device" />
                                <TextBlock x:Name="MicrophonePlaceholder" Style="{StaticResource EndpointPlaceholder}"
                                           Tag="{Binding SelectedIndex, ElementName=MicrophonePicker}" Text="Choose a microphone" />
                            </Grid>
                        </DockPanel>
                        <TextBlock Text="Saved track order" Style="{StaticResource SectionHeader}" />
                        <StackPanel x:Name="EndpointRows" />
                        <Button x:Name="RefreshDevicesButton" Content="Refresh devices" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Click="RefreshEndpoints_Click" />
                        <TextBlock x:Name="EndpointNotice" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   AutomationProperties.LiveSetting="Polite" />
                        <Expander Header="Running audio lanes" Margin="0,10,0,0" Collapsed="EndpointStatus_Collapsed">
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="Reads the current session without opening a device. Packet peaks appear when recording diagnostics sample them."
                                           Style="{StaticResource Hint}" Margin="0,0,0,6" />
                                <Button x:Name="ReadEndpointStatusButton" Content="Read current status" HorizontalAlignment="Left"
                                        Click="ReadEndpointStatus_Click" />
                                <TextBlock x:Name="EndpointStatusText" Style="{StaticResource Hint}" Margin="0,4,0,0"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                    <StackPanel x:Name="LegacyAudioPanel" Margin="0,8,0,0">
                        <TextBlock x:Name="AudioHint" Style="{StaticResource Hint}" TextWrapping="Wrap"
                                   Text="Clips get a separate track for each source, named in the editor, so you can set their volumes or merge them when exporting." />
                        <CheckBox x:Name="SplitChatCheck" Margin="0,12,0,0" Checked="Changed" Unchecked="Changed">
                            <TextBlock Text="Put voice chat on its own track (Discord, TeamSpeak, Mumble, Teams, Zoom and more)" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock x:Name="ChatText" Margin="28,4,0,0" Style="{StaticResource Hint}" />
                        <CheckBox x:Name="SplitMusicCheck" Margin="0,10,0,0" Checked="Changed" Unchecked="Changed">
                            <TextBlock Text="Put music on its own track (Spotify, TIDAL, Apple Music, Deezer, Amazon Music and more)" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock x:Name="MusicText" Margin="28,4,0,0" Style="{StaticResource Hint}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="MicCheck" Content="Microphone" VerticalAlignment="Top" Checked="Changed" Unchecked="Changed" />
                            <StackPanel Grid.Column="1">
                                <!-- A row per microphone, filled in by the code -->
                                <StackPanel x:Name="MicList" />
                                <Button x:Name="AddMicButton" Style="{StaticResource TextButton}" Content="Add another microphone" HorizontalAlignment="Left"
                                        Margin="0,8,0,0" Click="AddMic_Click" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="MicTracksRow" Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Microphone tracks" VerticalAlignment="Center" />
                            <ComboBox x:Name="MicTracksCombo" Grid.Column="1" SelectionChanged="Changed" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Hotkey -->
            <Border x:Name="HotkeysCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Recording hotkeys" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Select a shortcut to change it. Clear leaves it unbound. Reset restores that command’s default."
                               Style="{StaticResource Hint}" Margin="0,4,0,0" />
                    <StackPanel x:Name="HotkeyRows" />
                </StackPanel>
            </Border>

            <!-- Sharing -->
            <Border x:Name="SharingCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Sharing" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="Share makes a copy of a clip under the size limit at up to 60 fps, with all its audio on one track, and copies it to the clipboard." />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Size limit" VerticalAlignment="Center" />
                        <TextBox x:Name="ShareSizeBox" Grid.Column="1" Style="{StaticResource CompactBox}" Padding="8,6"
                                 KeyDown="ShareSize_KeyDown" LostKeyboardFocus="ShareSize_Commit"
                                 ToolTip="Shared copies are made to fit under this size" />
                        <TextBlock Grid.Column="2" Text="MB" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Hint}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Hint}" Margin="160,4,0,0" TextWrapping="Wrap"
                               Text="Smaller copies upload faster but look softer. Discord takes up to 10 MB without Nitro." />
                    <CheckBox x:Name="MotionBlurCheck" Margin="0,10,0,0" Checked="Changed" Unchecked="Changed">
                        <TextBlock Text="Smooth motion: blend the extra frames of clips over 60 fps (like 120 fps) into motion blur" TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock Style="{StaticResource Hint}" Margin="28,2,0,0" TextWrapping="Wrap"
                               Text="The 60 fps copy looks smoother than one that just drops every other frame. Sharing takes a little longer." />
                </StackPanel>
            </Border>

            <!-- General -->
            <Border x:Name="GeneralCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="General" Style="{StaticResource CardTitle}" />
                    <CheckBox x:Name="StartupCheck" Content="Start QuickClip with Windows (in the tray)" Margin="0,10,0,0" Checked="Changed" Unchecked="Changed" />
                    <CheckBox x:Name="MinTrayCheck" Content="Minimizing hides QuickClip to the tray" Margin="0,8,0,0" Checked="Changed" Unchecked="Changed" />
                    <CheckBox x:Name="CloseTrayCheck" Content="Closing the window keeps QuickClip running in the tray" Margin="0,8,0,0" Checked="Changed" Unchecked="Changed" />
                    <CheckBox x:Name="ConfirmDeleteCheck" Content="Confirm before sending clips to the Recycle Bin" Margin="0,8,0,0" Checked="Changed" Unchecked="Changed" />
                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <CheckBox x:Name="SoundCheck" Content="Play a sound when a clip is saved" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed" />
                        <Button Style="{StaticResource TextButton}" Content="Play" ToolTip="Hear the sound" Margin="10,0,0,0" VerticalAlignment="Center"
                                Click="PlayClipSound_Click" />
                    </StackPanel>
                    <CheckBox x:Name="WindowsClipNotificationCheck" Content="Show Windows clip notifications"
                              Margin="0,8,0,0" Click="ClipFeedback_Changed" />
                    <CheckBox x:Name="IdleSaveNotificationCheck"
                              Content="Warn when Save Clip is pressed with no active game or recording"
                              Margin="0,8,0,0" Checked="Changed" Unchecked="Changed" />
                    <StackPanel x:Name="ClipOverlayPanel" Margin="0,12,0,0">
                        <CheckBox x:Name="ClipOverlayCheck" Content="Show on-screen clip indicator" Click="ClipFeedback_Changed" />
                        <StackPanel x:Name="ClipOverlayOptions" Margin="18,8,0,0" Visibility="Collapsed">
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Display" />
                                    <ComboBox x:Name="OverlayDisplayCombo" SelectionChanged="ClipFeedback_Changed" AutomationProperties.Name="Indicator display" />
                                    <TextBlock Text="Position" Margin="0,8,0,0" />
                                    <ComboBox x:Name="OverlayAnchorCombo" SelectionChanged="ClipFeedback_Changed" AutomationProperties.Name="Indicator position" />
                                    <TextBlock Text="Animation" Margin="0,8,0,0" />
                                    <ComboBox x:Name="OverlayAnimationCombo" SelectionChanged="ClipFeedback_Changed" AutomationProperties.Name="Indicator animation" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Size" />
                                    <ComboBox x:Name="OverlaySizeCombo" SelectionChanged="ClipFeedback_Changed" AutomationProperties.Name="Indicator size" />
                                    <TextBlock Text="Opacity" Margin="0,8,0,0" />
                                    <ComboBox x:Name="OverlayOpacityCombo" SelectionChanged="ClipFeedback_Changed" AutomationProperties.Name="Indicator opacity" />
                                    <TextBlock Text="Duration" Margin="0,8,0,0" />
                                    <ComboBox x:Name="OverlayDurationCombo" SelectionChanged="ClipFeedback_Changed" AutomationProperties.Name="Indicator duration" />
                                </StackPanel>
                            </Grid>
                            <Button Content="Test indicator" HorizontalAlignment="Left" Margin="0,10,0,0" Click="TestClipOverlay_Click" />
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                       Text="Visible over windowed and borderless games. Exclusive fullscreen and capture exclusion depend on Windows and the capture backend." />
                        </StackPanel>
                    </StackPanel>
                    <CheckBox x:Name="ShellCheck" Margin="0,8,0,0" Checked="ShellCheck_Changed" Unchecked="ShellCheck_Changed">
                        <TextBlock Text="Add &quot;Edit with QuickClip&quot; to the right-click menu of video and audio files" TextWrapping="Wrap" />
                    </CheckBox>

                </StackPanel>
            </Border>
            <Border x:Name="LibraryCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Saved recordings location" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="New recordings are saved here. Gallery can also show clips from additional sources." Style="{StaticResource Hint}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderBox" IsReadOnly="True" Style="{StaticResource CompactBox}" Padding="8,6"
                                 AutomationProperties.Name="Saved recordings location" />
                        <Button Grid.Column="1" Content="Change…" Margin="8,0,0,0" Click="ChangeFolder_Click" />
                    </Grid>
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Open folder" Click="OpenRecordingFolder_Click" />
                        <TextBlock x:Name="RecordingFreeSpace" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                    </DockPanel>
                    <StackPanel x:Name="LibraryOptions" Margin="0,16,0,0">
                        <TextBlock Text="Additional Gallery sources" FontWeight="SemiBold" />
                        <TextBlock Text="These folders stay visible in Gallery. New recordings go to the location above." Style="{StaticResource Hint}" />
                        <ListBox x:Name="AdditionalSourcesList" Margin="0,6,0,0" MaxHeight="180"
                                 AutomationProperties.Name="Additional Gallery sources" />
                        <WrapPanel Margin="0,6,0,12">
                            <Button Content="Add existing folder…" Click="AddClipSource_Click" Margin="0,0,8,4" />
                            <Button Content="Remove from Gallery…" Click="RemoveClipSource_Click" Margin="0,0,8,4" />
                        </WrapPanel>
                        <CheckBox x:Name="IndexLibraryCheck" Content="Index Gallery sources and store annotations in SQLite"
                                  Click="IndexLibrary_Click" Margin="0,0,0,10" />
                        <TextBlock Text="Clip filename template" />
                        <TextBox x:Name="FilenameTemplate" Margin="0,5,0,0" TextChanged="FilenameTemplate_Changed"
                                 LostKeyboardFocus="FilenameTemplate_Commit" />
                        <TextBlock x:Name="FilenamePreview" Margin="0,5,0,0" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                        <TextBlock Text="Excluded subfolders (relative to each Gallery source, one per line)" Margin="0,12,0,0" TextWrapping="Wrap" />
                        <TextBox x:Name="ExclusionsBox" Margin="0,5,0,0" AcceptsReturn="True" MinHeight="50"
                                 LostKeyboardFocus="Exclusions_Commit" />
                    </StackPanel>
                </StackPanel>
            </Border>
            </controls:ResponsiveCards>
        </StackPanel>
        </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
