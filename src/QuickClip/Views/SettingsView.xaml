<UserControl x:Class="QuickClip.Views.SettingsView" xmlns:controls="clr-namespace:QuickClip.Controls" xmlns:views="clr-namespace:QuickClip.Views"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuickClip;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="DriveUsageTemplate">
                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="{Binding Header}" FontWeight="SemiBold" TextWrapping="Wrap" FontSize="{DynamicResource QuickClipText16}" />
                    <Grid Height="14" Margin="0,12,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding TrackedWidth}" />
                            <ColumnDefinition Width="{Binding OtherWidth}" />
                            <ColumnDefinition Width="{Binding FreeWidth}" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource AccentBrush}" CornerRadius="7" />
                        <Border Grid.Column="1" Background="{DynamicResource DisabledBrush}" CornerRadius="7" />
                        <Border Grid.Column="2" Background="{DynamicResource SuccessBrush}" CornerRadius="7" />
                    </Grid>
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,6"><Ellipse Width="9" Height="9" Fill="{DynamicResource AccentBrush}" Margin="0,0,6,0" /><TextBlock Text="{Binding Tracked}" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,6"><Ellipse Width="9" Height="9" Fill="{DynamicResource DisabledBrush}" Margin="0,0,6,0" /><TextBlock Text="{Binding Other}" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" /></StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,6"><Ellipse Width="9" Height="9" Fill="{DynamicResource SuccessBrush}" Margin="0,0,6,0" /><TextBlock Text="{Binding Free}" Foreground="{DynamicResource PrimaryTextBrush}" TextWrapping="Wrap" /></StackPanel>
                    </WrapPanel>
                    <Border Background="{DynamicResource ElevatedSurfaceBrush}" CornerRadius="7" Padding="10" Margin="0,4,0,6"><TextBlock Text="{Binding Capacity}" FontWeight="SemiBold" TextWrapping="Wrap" /></Border>
                    <TextBlock Text="{Binding Note}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,3,0,0" />
                </StackPanel>
                </Border>
            </DataTemplate>
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="20,8,20,18" />
                <Setter Property="Margin" Value="0,0,14,14" />
            </Style>
            <Style x:Key="CardTitle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="{DynamicResource QuickClipText16}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,10,0,4" />
            </Style>
            <!-- Clear visual hierarchy: master switch lives in Recording, never beside Save Clip. -->
            <Style x:Key="ReplayMasterControl" TargetType="CheckBox">
                <Setter Property="Focusable" Value="True" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="AutomationProperties.Name" Value="Enable instant replay" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <Border x:Name="MasterCard" Background="{DynamicResource ElevatedSurfaceBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                    BorderThickness="1" CornerRadius="9" Padding="15,13">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="Game and desktop capture" FontWeight="SemiBold" FontSize="{DynamicResource QuickClipText15}"
                                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                                        <TextBlock Text="Enable instant replay for recognized games"
                                                   FontSize="{DynamicResource QuickClipText12}" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,5,10,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <controls:SwitchVisual x:Name="SwitchTrack" Grid.Column="1" Width="{DynamicResource QuickClipVisual44}"
                                            Height="{DynamicResource QuickClipVisual24}" VerticalAlignment="Center"
                                            IsOn="{TemplateBinding IsChecked}" TrackBrush="{DynamicResource SwitchOffBrush}"
                                            OutlineBrush="{DynamicResource SwitchOutlineBrush}" ThumbBrush="{DynamicResource SwitchOffThumbBrush}" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="SwitchTrack" Property="TrackBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="SwitchTrack" Property="OutlineBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="SwitchTrack" Property="ThumbBrush" Value="{DynamicResource SwitchThumbBrush}" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="MasterCard" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="MasterCard" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="MasterCard" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="Row" TargetType="Grid">
                <Setter Property="Margin" Value="0,10,0,0" />
            </Style>
            <Style x:Key="AudioSourceIconButton" TargetType="Button" BasedOn="{StaticResource IconButton}">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Margin" Value="2,0,0,0" />
                <Setter Property="Padding" Value="2" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" CornerRadius="5" Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Chrome" Property="BorderThickness" Value="1"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Chrome" Property="Opacity" Value=".4"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="AudioSourceRemoveButton" TargetType="Button" BasedOn="{StaticResource AudioSourceIconButton}">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
            <Style x:Key="AudioSourceTestButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
                <Setter Property="Height" Value="28" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Padding" Value="9,2" />
                <Setter Property="Margin" Value="4,0,2,0" />
                <Setter Property="FontSize" Value="11" />
            </Style>
            <Style x:Key="AudioSourceDragHandle" TargetType="Button">
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="28" />
                <Setter Property="MinWidth" Value="28" />
                <Setter Property="MinHeight" Value="28" />
                <Setter Property="Margin" Value="3,0,0,0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                <Setter Property="Cursor" Value="SizeAll" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome" CornerRadius="5" Background="Transparent"
                                    BorderBrush="{DynamicResource AccentBrush}" BorderThickness="0">
                                <Grid x:Name="Dots" Width="9" Height="17" Opacity=".55"
                                      HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4.5" />
                                        <ColumnDefinition Width="4.5" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="5.67" />
                                        <RowDefinition Height="5.67" />
                                        <RowDefinition Height="5.66" />
                                    </Grid.RowDefinitions>
                                    <Ellipse Grid.Row="0" Grid.Column="0" Width="3" Height="3" Fill="{TemplateBinding Foreground}" />
                                    <Ellipse Grid.Row="0" Grid.Column="1" Width="3" Height="3" Fill="{TemplateBinding Foreground}" />
                                    <Ellipse Grid.Row="1" Grid.Column="0" Width="3" Height="3" Fill="{TemplateBinding Foreground}" />
                                    <Ellipse Grid.Row="1" Grid.Column="1" Width="3" Height="3" Fill="{TemplateBinding Foreground}" />
                                    <Ellipse Grid.Row="2" Grid.Column="0" Width="3" Height="3" Fill="{TemplateBinding Foreground}" />
                                    <Ellipse Grid.Row="2" Grid.Column="1" Width="3" Height="3" Fill="{TemplateBinding Foreground}" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Dots" Property="Opacity" Value="1"/>
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SelectionBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Dots" Property="Opacity" Value="1"/>
                                    <Setter TargetName="Chrome" Property="BorderThickness" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <Style x:Key="EndpointPlaceholder" TargetType="TextBlock" BasedOn="{StaticResource Hint}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Setter Property="IsHitTestVisible" Value="False" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="12,0,30,0" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="-1">
                        <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Settings' vertical section rail sits beside the application's primary navigation. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SectionsColumn" Width="176" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border x:Name="SettingsSidebar" Grid.Column="0" Background="{DynamicResource InternalSidebarBrush}"
                BorderThickness="0" Padding="8,16,8,16">
            <!-- Left navigation uses comfortable centered spacing; shrink/scroll when DPI requires. -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          VerticalContentAlignment="Center" HorizontalContentAlignment="Stretch">
                <StackPanel x:Name="SettingsSections" KeyboardNavigation.DirectionalNavigation="Contained"
                            PreviewKeyDown="SectionKeys" VerticalAlignment="Center">
                    <StackPanel.Resources>
                        <Style TargetType="RadioButton" BasedOn="{StaticResource {x:Type RadioButton}}">
                            <Setter Property="GroupName" Value="SettingsSection" />
                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                            <Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
                            <Setter Property="AutomationProperties.Name" Value="{Binding Content, RelativeSource={RelativeSource Self}}" />
                            <Setter Property="MinHeight" Value="{DynamicResource QuickClipVisual40}" />
                            <Setter Property="MinWidth" Value="0" />
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="Cursor" Value="Hand" />
                            <Setter Property="Focusable" Value="True" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="RadioButton">
                                        <Border x:Name="RailButton" Background="Transparent" CornerRadius="8"
                                                BorderThickness="1" BorderBrush="Transparent"
                                                Padding="5,11,5,10" Margin="5,4">
                                            <Grid>
                                                <Border x:Name="SelectedAccent" Background="{DynamicResource AccentBrush}"
                                                        Width="3" Height="25" HorizontalAlignment="Left" VerticalAlignment="Center"
                                                        CornerRadius="2" Visibility="Collapsed" />
                                                <Border Background="{DynamicResource WarningBrush}"
                                                        CornerRadius="11" MinWidth="22" Height="22" HorizontalAlignment="Right" VerticalAlignment="Top" Padding="3,0"
                                                        Visibility="{Binding DataContext.Visibility, RelativeSource={RelativeSource TemplatedParent}, FallbackValue=Collapsed}">
                                                    <TextBlock Text="{Binding DataContext.Count, RelativeSource={RelativeSource TemplatedParent}}"
                                                               Foreground="{DynamicResource OnWarningBrush}" FontSize="{DynamicResource QuickClipText12}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold" />
                                                </Border>
                                                <StackPanel x:Name="ItemContent" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock x:Name="SectionGlyph" Text="{TemplateBinding Tag}"
                                                               FontFamily="{StaticResource IconFont}"
                                                               FontSize="{DynamicResource QuickClipVisual19}"
                                                               HorizontalAlignment="Center" Foreground="{DynamicResource SubtleText}" />
                                                    <TextBlock x:Name="SectionLabel" Text="{TemplateBinding Content}"
                                                               Margin="0,6,0,0" FontSize="{DynamicResource QuickClipText13}"
                                                               TextAlignment="Center" HorizontalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="RailButton" Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="RailButton" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                                <Setter TargetName="SectionGlyph" Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                                <Setter TargetName="SectionLabel" Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                                                <Setter TargetName="SelectedAccent" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=StackPanel}}" Value="True">
                                                <Setter TargetName="SectionLabel" Property="Visibility" Value="Collapsed" />
                                                <Setter TargetName="RailButton" Property="Padding" Value="4,12" />
                                            </DataTrigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="RailButton" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <EventSetter Event="Checked" Handler="SettingsSection_Changed" />
                        </Style>
                    </StackPanel.Resources>
                    <RadioButton x:Name="RecordingSection" Content="Recording" Tag="&#xE714;" IsChecked="True" />
                    <RadioButton x:Name="AudioSection" Content="Audio" Tag="&#xE767;" />
                    <RadioButton x:Name="GamesSection" Content="Sources" Tag="&#xE7FC;" ToolTip="Game discovery and Discord recording" />
                    <RadioButton x:Name="HotkeysSection" Content="Hotkeys" Tag="&#xE765;" />
                    <RadioButton x:Name="SharingSection" Content="Sharing" Tag="&#xE72D;" />
                    <RadioButton x:Name="LibrarySection" Content="Library" Tag="&#xE8B7;" />
                    <RadioButton x:Name="NotificationsSection" Content="Notifications" Tag="&#xE7E7;" />
                    <RadioButton x:Name="GeneralSection" Content="General" Tag="&#xE713;" />
                    <RadioButton x:Name="DiagnosticsSection" Content="Diagnostics" Tag="&#xE9CE;" />
                </StackPanel>
            </ScrollViewer>
        </Border>
        <Grid Grid.Column="1" x:Name="SettingsExperienceLayout">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <StackPanel Grid.Row="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          MaxHeight="{Binding ActualHeight, ElementName=SettingsExperienceLayout}">
            <StackPanel x:Name="ExperienceHeader" Margin="20,10,20,0" Visibility="Collapsed">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Right" HorizontalAlignment="Right">
                        <Button x:Name="ModeButton" Content="Advanced settings" Click="SettingsMode_Click" Margin="4,0,0,4" />
                        <Button x:Name="SetupGuideButton" Content="Guided setup" Click="SetupGuide_Click" Margin="4,0,0,4" />
                    </WrapPanel>
                    <TextBlock x:Name="ModeLabel" Text="Basic settings" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <Border x:Name="GuideBanner" Visibility="Collapsed" Background="{DynamicResource ElevatedSurfaceBrush}" CornerRadius="9" Padding="14" Margin="0,8,0,8">
                    <StackPanel>
                        <TextBlock x:Name="GuideProgressLabel" Style="{StaticResource Hint}" />
                        <ProgressBar x:Name="GuideProgress" Minimum="0" Maximum="9" Height="5" Margin="0,4,0,8" />
                        <TextBlock x:Name="GuideTitle" FontSize="{DynamicResource QuickClipText24}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="GuideHint" TextWrapping="Wrap" Margin="0,5,0,8" AutomationProperties.LiveSetting="Polite" />
                        <WrapPanel x:Name="GuideIntroFlow" Visibility="Collapsed" Margin="0,3,0,10">
                            <Border Background="{DynamicResource PanelBrush}" CornerRadius="7" Padding="12,9" Margin="0,0,8,5">
                                <StackPanel><TextBlock Text="1 · Start a game" FontWeight="SemiBold" /><TextBlock Style="{StaticResource Hint}" Text="QuickClip detects it" /></StackPanel>
                            </Border>
                            <Border Background="{DynamicResource PanelBrush}" CornerRadius="7" Padding="12,9" Margin="0,0,8,5">
                                <StackPanel><TextBlock Text="2 · Keep replay ready" FontWeight="SemiBold" /><TextBlock Style="{StaticResource Hint}" Text="Recent moments in memory" /></StackPanel>
                            </Border>
                            <Border Background="{DynamicResource PanelBrush}" CornerRadius="7" Padding="12,9" Margin="0,0,8,5">
                                <StackPanel><TextBlock Text="3 · Save a clip" FontWeight="SemiBold" /><TextBlock Style="{StaticResource Hint}" Text="Shortcut or Save Clip" /></StackPanel>
                            </Border>
                        </WrapPanel>
                        <ItemsControl x:Name="GuideSummaryViewport" AutomationProperties.Name="Setup summary" Visibility="Collapsed" Margin="0,4,0,8">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="10,7" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding Label}" Width="132" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DockPanel LastChildFill="True">
                            <Button x:Name="GuideBack" DockPanel.Dock="Left" Content="Back" Click="GuideBack_Click" Margin="0,0,8,4" VerticalAlignment="Top" />
                            <StackPanel HorizontalAlignment="Right">
                                <WrapPanel HorizontalAlignment="Right" FlowDirection="LeftToRight">
                                    <Button x:Name="GuideCancel" Content="Close setup" Style="{StaticResource TextButton}" Click="GuideCancel_Click" Margin="0,0,8,4"
                                            ToolTip="Keep your choices and resume setup later. Does not change recording." />
                                    <Button VerticalContentAlignment="Center" HorizontalContentAlignment="Center" MinHeight="{DynamicResource QuickClipVisual36}" MinWidth="{DynamicResource QuickClipVisual36}" x:Name="GuideNext" Content="Continue" Click="GuideNext_Click" Margin="0,0,0,4" Style="{DynamicResource AccentButtonStyle}" />
                                </WrapPanel>
                                <TextBlock x:Name="GuideCompletionNotice" Text="Finishing setup enables recording."
                                           Visibility="Collapsed" Style="{StaticResource Hint}" TextWrapping="Wrap" MaxWidth="290" HorizontalAlignment="Right" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock x:Name="GuideError" TextWrapping="Wrap" Foreground="{DynamicResource DangerBrush}" AutomationProperties.LiveSetting="Assertive" />
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
            </StackPanel>
            <Grid Grid.Row="1">
        <views:GamesSettingsView x:Name="GamesPage" Visibility="Collapsed" />
        <ScrollViewer x:Name="GeneralPage" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="SettingsContent" MaxWidth="1340" Margin="28,22,14,28" HorizontalAlignment="Center">
            <TextBlock x:Name="SectionTitle" Text="Settings" FontSize="{DynamicResource QuickClipText24}" FontWeight="SemiBold" Margin="0,0,0,16" />

            <TextBlock x:Name="PersonalProfileHint" Style="{StaticResource Hint}" Visibility="Collapsed"
                       TextWrapping="Wrap" Margin="0,0,0,14" />

            <controls:ResponsiveCards>
            <!-- Updates -->
            <Border x:Name="UpdatesCard" Style="{StaticResource Card}">
                <StackPanel>
                    <DockPanel Margin="0,10,0,0">
                        <Button x:Name="CheckUpdatesButton" DockPanel.Dock="Right" Style="{StaticResource TextButton}" Margin="0" VerticalAlignment="Center"
                                Click="CheckUpdates_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE72C;" VerticalAlignment="Center" Margin="0,0,7,0"  TextWrapping="Wrap" />
                                <TextBlock Text="Check for updates" />
                            </StackPanel>
                        </Button>
                        <Button DockPanel.Dock="Right" Style="{StaticResource TextButton}" Margin="0,0,8,0" VerticalAlignment="Center"
                                Click="ThisVersionNotes_Click" ToolTip="The release notes of the version you have">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE789;" VerticalAlignment="Center" Margin="0,0,7,0"  TextWrapping="Wrap" />
                                <TextBlock Text="What's new" />
                            </StackPanel>
                        </Button>
                        <StackPanel>
                            <TextBlock Text="Updates" Style="{StaticResource CardTitle}" Margin="0,0,0,2" />
                            <TextBlock x:Name="VersionText" Style="{StaticResource Hint}" />
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="UpdateStatusText" Margin="0,12,0,0" TextWrapping="Wrap" />
                    <StackPanel x:Name="UpdateActions" Orientation="Horizontal" Margin="0,10,0,0" Visibility="Collapsed">
                        <Button VerticalContentAlignment="Center" HorizontalContentAlignment="Center" MinHeight="{DynamicResource QuickClipVisual36}" MinWidth="{DynamicResource QuickClipVisual36}" x:Name="InstallUpdateButton" Style="{DynamicResource AccentButtonStyle}" Padding="12,5" Focusable="False" Click="InstallUpdate_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" VerticalAlignment="Center" Margin="0,0,7,0"  TextWrapping="Wrap" />
                                <TextBlock x:Name="InstallUpdateLabel" Text="Install and restart" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TextButton}" Content="What's new" Margin="8,0,0,0" Click="WhatsNew_Click" />
                    </StackPanel>
                    <ProgressBar x:Name="UpdateProgress" Height="6" Margin="0,12,0,0" Maximum="1" Visibility="Collapsed" />
                    <Grid Style="{StaticResource Row}" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Channel" VerticalAlignment="Center"  TextWrapping="Wrap" />
                        <ComboBox x:Name="ChannelCombo" Grid.Column="1" SelectionChanged="Channel_Changed" />
                    </Grid>
                    <TextBlock x:Name="ChannelHint" Style="{StaticResource Hint}" Margin="160,4,0,0" TextWrapping="Wrap" />
                    <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="AutoUpdateCheck" Content="Check for updates automatically when QuickClip starts" Margin="0,12,0,0"
                              Checked="AutoUpdate_Changed" Unchecked="AutoUpdate_Changed" />
                </StackPanel>
            </Border>

            <!-- Recording -->
            <Border x:Name="RecordingCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Instant replay" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource Hint}"
                               Text="QuickClip keeps the last few minutes of your screen in memory; press the hotkey to save them as a clip. Nothing is written to disk until you do." />
                    <CheckBox x:Name="RecordingCheck" Style="{StaticResource ReplayMasterControl}" Margin="0,14,0,2" Checked="Changed" Unchecked="Changed" />

                    <TextBlock x:Name="RecordingSourceLabel" Text="Recording source" Margin="0,12,0,4" />
                    <ComboBox x:Name="SourceCombo" SelectionChanged="Changed" AutomationProperties.Name="Recording source">
                        <ComboBoxItem x:Name="GameSourceItem" Content="Automatic - Game First" />
                        <ComboBoxItem x:Name="DisplaySourceItem" Content="Selected monitor" />
                    </ComboBox>
                    <TextBlock x:Name="CaptureTargetHint" Style="{StaticResource Hint}" Margin="0,6,0,4" TextWrapping="Wrap" />
                    <Border x:Name="CapturePermissionCard" Background="{DynamicResource CardBrush}" CornerRadius="9" Padding="14" Margin="0,12,0,0">
                        <StackPanel>
                            <!-- One monitor layout serves guided setup and ordinary Personal settings. -->
                            <StackPanel x:Name="VisualDisplayPanel" Visibility="Collapsed" Margin="0,5,0,0">
                                <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="ManualDesktopButton"
                                          Visibility="Collapsed" Content="Manual desktop capture"
                                          FontWeight="SemiBold" Margin="0,0,0,3"
                                          ToolTip="Explicitly start or stop an entire-display recording session" Click="ManualDesktop_Click" />
                                <TextBlock x:Name="ManualDisplayHint" Style="{StaticResource Hint}"
                                           Text="Manual desktop capture stays off until you switch it on. It records everything visible on the selected screen, including messages."
                                           TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite" />
                                <DockPanel LastChildFill="True" Margin="0,0,0,5">
                                    <Button x:Name="RefreshDisplaysButton" DockPanel.Dock="Right" Content="Refresh displays"
                                            Style="{StaticResource TextButton}" Click="RefreshDisplays_Click"
                                            ToolTip="Find connected displays again" Margin="8,0,0,0" />
                                    <TextBlock Text="Where recording is allowed" FontWeight="SemiBold" VerticalAlignment="Center"
                                               FontSize="{DynamicResource QuickClipText16}" />
                                </DockPanel>
                                <TextBlock Text="Allow the screens QuickClip may record. Both enabled does not mean both record at once."
                                           Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,9" />
                                <RadioButton x:Name="NoManualDefaultButton" Content="No preferred screen for manual capture"
                                             GroupName="QuickClipManualDisplay" Visibility="Collapsed"
                                             Margin="2,0,0,9" Click="NoManualDefault_Click"
                                             ToolTip="Leave manual desktop capture without a preferred screen; it stays off until you start it." />
                                <WrapPanel x:Name="DisplayCardsPanel" KeyboardNavigation.TabNavigation="Continue" />
                                <TextBlock x:Name="DisplayPrivacyHint" Style="{StaticResource Hint}" TextWrapping="Wrap"
                                           Margin="0,0,0,9" />
                                <Button x:Name="RequireDisplayApprovalButton" Content="Require approval for new displays"
                                        Style="{StaticResource TextButton}" Click="RequireDisplayApproval_Click"
                                        HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,0,0,9" />
                                <TextBlock x:Name="DisplayTargetConflict" Foreground="{DynamicResource WarningBrush}"
                                           TextWrapping="Wrap" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite" />
                                <Button x:Name="AllowTargetButton" Content="Allow selected display"
                                        Style="{StaticResource TextButton}" Click="AllowSelectedDisplay_Click"
                                        HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,5,0,0" />
                                <Button x:Name="SelectSingleDisplayButton" Content="Use connected display"
                                        Style="{StaticResource TextButton}" Click="SelectSingleDisplay_Click"
                                        HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,5,0,0" />
                                <TextBlock x:Name="GuideManualCaptureHint" Style="{StaticResource Hint}"
                                           Text="Manual desktop capture is optional and stays off during setup. Start it later from Recording settings."
                                           TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed" />
                            </StackPanel>
                            <StackPanel x:Name="LegacyDisplayControls">
                                <TextBlock x:Name="MonitorLabel" Text="Monitor" TextWrapping="Wrap" Margin="0,6,0,4" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ComboBox x:Name="MonitorCombo" MinWidth="0" SelectionChanged="Changed" AutomationProperties.Name="Manual desktop display" />
                                    <CheckBox Grid.Column="1" x:Name="DisplayPermissionCheck" Style="{StaticResource SwitchCheckBox}"
                                              Margin="10,0,0,0" Visibility="Collapsed" Click="DisplayPermission_Click"
                                              Content="Allow recording on this display"
                                              ToolTip="Allows automatic game recording and deliberate manual recording on this display."
                                              ToolTipService.ShowOnDisabled="True"
                                              AutomationProperties.Name="Allow capture on selected display" />
                                </Grid>
                                <TextBlock x:Name="DisplayPermissionHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,5,0,0" Visibility="Collapsed" />
                                <Button x:Name="DefaultDisplayPermissionsButton" Content="Use default display permissions" Click="DefaultDisplayPermissions_Click" HorizontalAlignment="Left" Visibility="Collapsed" Margin="0,6,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="RecordingQualityControls">
                    <Border x:Name="SetupQualityPresets" Visibility="Collapsed" Background="{DynamicResource CardBrush}" CornerRadius="8" Padding="12" Margin="0,10,0,8">
                        <StackPanel>
                            <TextBlock Text="Recording presets" FontWeight="SemiBold" />
                            <TextBlock x:Name="SetupPresetRecommendation" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,6" />
                            <WrapPanel>
                                <Button Content="Performance · 720p / 30" Tag="Performance" Click="SetupPreset_Click" Margin="0,0,6,4" ToolTip="720p, 30 FPS, Medium, fast NVENC preset" />
                                <Button Content="Balanced · 1080p / 60" Tag="Balanced" Click="SetupPreset_Click" Margin="0,0,6,4" ToolTip="1080p, 60 FPS, High, fast NVENC preset" />
                                <Button Content="Quality · Native / 60" Tag="Quality" Click="SetupPreset_Click" Margin="0,0,6,4" ToolTip="Native size, 60 FPS, Ultra, fast NVENC preset" />
                            </WrapPanel>
                            <TextBlock x:Name="SetupPresetStatus" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                            <TextBlock Text="Adjust any video setting below. Audio and clip length stay unchanged." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Border>

                    <StackPanel x:Name="GameProfilePanel" Visibility="Collapsed" Margin="0,12,0,0">
                        <TextBlock Text="Recording profile" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <ComboBox x:Name="GameProfileCombo" SelectionChanged="GameProfile_Changed"
                                  AutomationProperties.Name="Recording profile" MaxDropDownHeight="320">
                            <ComboBox.ItemContainerStyle><Style TargetType="ComboBoxItem">
                                <Setter Property="IsEnabled" Value="{Binding Enabled}" />
                            </Style></ComboBox.ItemContainerStyle>
                            <ComboBox.ItemTemplate><DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Label}" />
                                    <TextBlock Text="  ·  Override" FontWeight="SemiBold" Margin="6,0,0,0">
                                        <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers><DataTrigger Binding="{Binding HasOverrides}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                        </Style></TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate></ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBlock x:Name="GameProfileStatus" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        <StackPanel x:Name="GameOverridePanel" Visibility="Collapsed" Margin="0,6,0,0">
                            <Button x:Name="ResetProfileButton" Content="Reset entire game profile…" HorizontalAlignment="Left" Click="ResetGameProfile_Click" />
                        </StackPanel>

                    </StackPanel>
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition x:Name="CaptureAreaColumn" Width="*" /><ColumnDefinition x:Name="CaptureAreaGap" Width="12" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <StackPanel x:Name="CaptureAreaAdvanced" Grid.Column="0">
                    <StackPanel Margin="0,0,0,4">
                            <DockPanel VerticalAlignment="Center" Margin="0,0,4,4"><Button DockPanel.Dock="Left" x:Name="ResetAspectOverride" Content="&#xE72C;" Tag="Aspect" Click="ResetGameField_Click" Style="{StaticResource IconButton}" Margin="0,0,4,0" Visibility="Collapsed" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(AutomationProperties.Name)}" AutomationProperties.Name="Reset Capture area override" /><TextBlock x:Name="AreaLabel" Text="Capture area" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                            <ComboBox x:Name="AreaCombo" MinWidth="0" SelectionChanged="Changed" AutomationProperties.Name="Capture area" />
                        </StackPanel>
                    <Expander Header="Custom aspect ratio" Margin="0,4,0,0">
                        <StackPanel Margin="0,4,0,6">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Apply ratio" Click="ApplyAspect_Click" Margin="8,0,0,0" />
                                <TextBox x:Name="CustomAspectBox" MaxLength="24" ToolTip="Enter a ratio like 32:9"
                                         AutomationProperties.Name="Custom aspect ratio" TextChanged="CustomAspect_Changed" />
                            </DockPanel>
                            <TextBlock x:Name="CustomAspectHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                        </StackPanel>
                    </Expander>

                        </StackPanel>
                        <StackPanel Grid.Column="2">
                    <StackPanel Margin="0,0,0,4">
                            <DockPanel VerticalAlignment="Center" Margin="0,0,4,4"><Button DockPanel.Dock="Left" x:Name="ResetResolutionOverride" Content="&#xE72C;" Tag="Resolution" Click="ResetGameField_Click" Style="{StaticResource IconButton}" Margin="0,0,4,0" Visibility="Collapsed" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(AutomationProperties.Name)}" AutomationProperties.Name="Reset Output resolution override" /><TextBlock x:Name="ResolutionLabel" Text="Output resolution" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                            <ComboBox x:Name="ResolutionCombo" MinWidth="0" SelectionChanged="Changed" AutomationProperties.Name="Output resolution" />
                        </StackPanel>
                    <Expander x:Name="CustomSizeAdvanced" Header="Custom output size" Margin="0,4,0,0">
                        <StackPanel Margin="0,4,0,6">
                            <TextBlock Text="Width × height in pixels" Margin="0,0,0,4" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="CustomWidthBox" MaxLength="10" ToolTip="Output width in pixels"
                                         AutomationProperties.Name="Output width" TextChanged="CustomDimension_Changed" />
                                <TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" Margin="8,0"  TextWrapping="Wrap" />
                                <TextBox x:Name="CustomHeightBox" Grid.Column="2" MaxLength="10" ToolTip="Output height in pixels"
                                         AutomationProperties.Name="Output height" TextChanged="CustomDimension_Changed" />
                            </Grid>
                            <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="LockOutputRatio" IsChecked="True" Margin="0,6,0,0">
                                <TextBlock Text="Match capture area when editing one dimension" TextWrapping="Wrap" />
                            </CheckBox>
                            <TextBlock x:Name="CustomSizeHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <WrapPanel Margin="0,4,0,0">
                                <Button x:Name="ApplySizeButton" Content="Apply size" Click="ApplySize_Click" Margin="0,0,8,0" />
                                <Button x:Name="CropToFitButton" Content="Crop to fit" Click="CropToFit_Click" Margin="0,0,8,0" />
                                <Button Content="Reset fields" Click="ResetSize_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Expander>
                        </StackPanel>
                    </Grid>
                    <Border x:Name="CropPreviewAdvanced" Background="{DynamicResource BackgroundBrush}" CornerRadius="6" Padding="10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock x:Name="PreviewHeading" Text="Selected monitor preview" FontWeight="SemiBold" />
                            <controls:RecordingAreaPreview x:Name="CropPreview" Height="100" Margin="4,8" Focusable="False" />
                            <TextBlock x:Name="PreviewDimensions" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock x:Name="PreviewHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <Button x:Name="UseNativeButton" Content="Use Native for every source" Click="UseNative_Click"
                                    HorizontalAlignment="Left" Margin="0,6,0,0" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <DockPanel VerticalAlignment="Center" Margin="0,0,4,4"><Button DockPanel.Dock="Left" x:Name="ResetBufferOverride" Content="&#xE72C;" Tag="Buffer" Click="ResetGameField_Click" Style="{StaticResource IconButton}" Margin="0,0,4,0" Visibility="Collapsed" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(AutomationProperties.Name)}" AutomationProperties.Name="Reset Clip length override" /><TextBlock x:Name="BufferLabel" Text="Clip length" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                        <Slider x:Name="BufferSlider" Grid.Column="1" Minimum="0" Maximum="10" TickFrequency="1" IsSnapToTickEnabled="True"
                                TickPlacement="BottomRight" VerticalAlignment="Center" ValueChanged="Changed" Focusable="False" />
                        <TextBlock x:Name="BufferText" Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0" FontWeight="SemiBold" />
                    </Grid>
                    <TextBlock x:Name="RamText" Margin="160,4,0,0" Style="{StaticResource Hint}" />
                    <Border x:Name="ResourceSummary" Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="16" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="Recording summary" FontWeight="SemiBold" FontSize="{DynamicResource QuickClipText16}" Margin="0,0,0,6" />
                            <TextBlock x:Name="ResourceVideo" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                            <TextBlock x:Name="ResourceSize" Style="{StaticResource Hint}" Margin="0,4,0,0" />
                            <ContentControl x:Name="RecordingDriveUsage" ContentTemplate="{StaticResource DriveUsageTemplate}" />
                            <TextBlock Text="Saved recordings location" FontWeight="SemiBold" Margin="0,12,0,4" />
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Content="Change…" Margin="8,0,0,0" Click="ChangeFolder_Click" />
                                <TextBox Text="{Binding Text, ElementName=FolderBox, Mode=OneWay}" IsReadOnly="True" MinWidth="0"
                                         AutomationProperties.Name="Saved recordings location" />
                            </DockPanel>
                            <TextBlock Text="{Binding Text, ElementName=FolderBox}" ToolTip="{Binding Text, ElementName=FolderBox}"
                                       Style="{StaticResource Hint}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="150" />
                        </Grid.ColumnDefinitions>
                        <DockPanel VerticalAlignment="Center" Margin="0,0,4,4"><Button DockPanel.Dock="Left" x:Name="ResetQualityOverride" Content="&#xE72C;" Tag="Quality" Click="ResetGameField_Click" Style="{StaticResource IconButton}" Margin="0,0,4,0" Visibility="Collapsed" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(AutomationProperties.Name)}" AutomationProperties.Name="Reset Quality override" /><TextBlock x:Name="QualityLabel" Text="Quality" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                        <ComboBox x:Name="QualityCombo" Grid.Column="1" SelectionChanged="Changed" />
                        <TextBlock x:Name="BitrateText" Grid.Column="2" VerticalAlignment="Center" Margin="14,0,0,0" Style="{StaticResource Hint}" />
                    </Grid>

                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel VerticalAlignment="Center" Margin="0,0,4,4"><Button DockPanel.Dock="Left" x:Name="ResetFpsOverride" Content="&#xE72C;" Tag="Fps" Click="ResetGameField_Click" Style="{StaticResource IconButton}" Margin="0,0,4,0" Visibility="Collapsed" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(AutomationProperties.Name)}" AutomationProperties.Name="Reset Frame rate override" /><TextBlock x:Name="FpsLabel" Text="Frame rate" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                        <ComboBox x:Name="FpsCombo" Grid.Column="1" SelectionChanged="Changed" />
                    </Grid>

                    <Grid x:Name="EncoderAdvanced" Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DockPanel VerticalAlignment="Center" Margin="0,0,4,4"><Button DockPanel.Dock="Left" x:Name="ResetEncoderOverride" Content="&#xE72C;" Tag="Encoder" Click="ResetGameField_Click" Style="{StaticResource IconButton}" Margin="0,0,4,0" Visibility="Collapsed" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(AutomationProperties.Name)}" AutomationProperties.Name="Reset Encoder override" /><TextBlock x:Name="EncoderLabel" Text="Encoder" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                        <ComboBox x:Name="EncoderCombo" Grid.Column="1" SelectionChanged="Changed" AutomationProperties.Name="Recording encoder">
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="IsEnabled" Value="{Binding Enabled}" />
                                </Style>
                            </ComboBox.ItemContainerStyle>
                            <ComboBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate><TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="8,5" /></DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ComboBox.GroupStyle>
                        </ComboBox>
                    </Grid>

                    <StackPanel x:Name="GameBitratePanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <DockPanel><Button DockPanel.Dock="Left" x:Name="ResetBitrateOverride" Content="&#xE72C;" Tag="Bitrate" Click="ResetGameField_Click" Style="{StaticResource IconButton}" Margin="0,0,4,0" Visibility="Collapsed" ToolTip="Reset bitrate to All Games" AutomationProperties.Name="Reset bitrate override" /><TextBlock Text="Target video bitrate (kbps; blank = Auto)" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                        <DockPanel Margin="0,4,0,0">
                            <Button DockPanel.Dock="Right" Content="Apply" Margin="8,0,0,0" Click="SaveGameBitrate_Click" />
                            <TextBox x:Name="GameBitrateBox" MaxLength="6" AutomationProperties.Name="Game target video bitrate" />
                        </DockPanel>
                        <TextBlock x:Name="GameBitrateHint" Style="{StaticResource Hint}" TextWrapping="Wrap" />

                    </StackPanel>
                    <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="CursorCheck" Content="Show the mouse pointer" Margin="160,12,0,0" Checked="Changed" Unchecked="Changed" />
                    <TextBlock x:Name="RecorderStatus" Margin="0,12,0,0" Style="{StaticResource Hint}" />
                    <TextBlock x:Name="BasicQualityHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Visibility="Collapsed" />
                    <StackPanel x:Name="EncoderTuningAdvanced">
                    <DockPanel VerticalAlignment="Center" Margin="0,0,4,4"><Button DockPanel.Dock="Left" x:Name="ResetNvencOverride" Content="&#xE72C;" Tag="Nvenc" Click="ResetGameField_Click" Style="{StaticResource IconButton}" Margin="0,0,4,0" Visibility="Collapsed" ToolTip="{Binding RelativeSource={RelativeSource Self}, Path=(AutomationProperties.Name)}" AutomationProperties.Name="Reset NVENC performance preset override" /><TextBlock x:Name="NvencLabel" Text="NVENC performance preset" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
                    <ComboBox x:Name="NvencPresetCombo" SelectionChanged="Changed" AutomationProperties.Name="NVENC performance preset" />
                    <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                               Text="P2 reduces encoder work. P3 and P4 can improve compression efficiency at the same bitrate. Game FPS and visual quality depend on the workload." />
                    <Expander Header="Advanced monitor backend" Margin="0,12,0,0">
                        <StackPanel Margin="0,8,0,0">
                            <ComboBox x:Name="BackendCombo" SelectionChanged="Changed" AutomationProperties.Name="Monitor capture backend" />
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                       Text="Desktop Duplication records everything visible on the selected display, including windows covering the game, and avoids the Windows capture indicator. Windows Graphics Capture may show an indicator. This preference applies to monitor capture. Game-window capture always uses Windows Graphics Capture." />
                        </StackPanel>
                    </Expander>
                    </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border x:Name="DiagnosticsCard" Style="{StaticResource Card}">
                <StackPanel>
                    <views:DiagnosticsView x:Name="DiagnosticEvents" />
                    <Expander x:Name="CaptureAdvanced" Header="Advanced Recording Diagnostics" Margin="0,12,0,0" Expanded="Diagnostics_Expanded">
                        <StackPanel Margin="0,10,0,0">
                            <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="DiagnosticsCheck" Content="Sample recording timings (every 5 seconds)" Margin="0,10,0,0" Checked="Changed" Unchecked="Changed" />
                            <TextBox x:Name="CaptureDiagnostics" IsReadOnly="True" TextWrapping="Wrap" Margin="0,10,0,0" />
                            <TextBlock Style="{StaticResource Hint}" Text="Enable only for testing: timing sampling can add CPU overhead. Results refresh every five seconds while this panel is visible. Sampling is off by default." Margin="0,8,0,0" />
                        </StackPanel>
                    </Expander>
                </StackPanel>
            </Border>

            <!-- Audio -->
            <Border x:Name="AudioCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Audio recording" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Record Game, Chat, Media, and microphone sources separately, then set how loud each should be in your future clips." Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,2,0,4" />
                    <TextBlock x:Name="BasicAudioHint" Style="{StaticResource Hint}" TextWrapping="Wrap" Visibility="Collapsed" />
                    <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="EndpointModeCheck" Content="Choose individual audio sources"
                              Margin="0,8,0,0" Checked="EndpointMode_Changed" Unchecked="EndpointMode_Changed" />
                    <StackPanel x:Name="EndpointPanel" Visibility="Collapsed" Margin="0,10,0,0">
                        <TextBlock x:Name="EndpointDetailHint" Style="{StaticResource Hint}" TextWrapping="Wrap"
                                   Text="Each source is saved separately. Mix percentages apply only to newly saved clips; existing clips stay as they were." />
                        <StackPanel x:Name="EndpointRows" Margin="0,4,0,0" />
                        <TextBlock Text="Add audio source" Style="{StaticResource SectionHeader}" Margin="0,14,0,6" />
                        <TextBlock Text="Playback output" Style="{StaticResource Hint}" Margin="0,0,0,4" />
                        <DockPanel>
                            <Button x:Name="AddPlaybackButton" DockPanel.Dock="Right" Content="Add playback" Margin="8,0,0,0"
                                    Click="AddEndpoint_Click" ToolTip="Add selected Windows playback device as a separate track" />
                            <Grid>
                                <ComboBox x:Name="PlaybackPicker" SelectionChanged="EndpointPicker_Changed"
                                          AutomationProperties.Name="Playback device" />
                                <TextBlock x:Name="PlaybackPlaceholder" Style="{StaticResource EndpointPlaceholder}"
                                           Tag="{Binding SelectedIndex, ElementName=PlaybackPicker}" Text="Choose a playback device" />
                            </Grid>
                        </DockPanel>
                        <TextBlock Text="Microphone input" Style="{StaticResource Hint}" Margin="10,12,0,4" />
                        <DockPanel>
                            <Button x:Name="AddMicrophoneButton" DockPanel.Dock="Right" Content="Add microphone" Margin="8,0,0,0"
                                    Click="AddEndpoint_Click" ToolTip="Add selected Windows microphone as a separate track" />
                            <Grid>
                                <ComboBox x:Name="MicrophonePicker" SelectionChanged="EndpointPicker_Changed"
                                          AutomationProperties.Name="Microphone input device" />
                                <TextBlock x:Name="MicrophonePlaceholder" Style="{StaticResource EndpointPlaceholder}"
                                           Tag="{Binding SelectedIndex, ElementName=MicrophonePicker}" Text="Choose a microphone" />
                            </Grid>
                        </DockPanel>
                        <Button x:Name="RefreshDevicesButton" Content="Refresh devices" HorizontalAlignment="Left" Margin="0,10,0,0"
                                Click="RefreshEndpoints_Click" Style="{StaticResource TextButton}" />
                        <TextBlock x:Name="EndpointNotice" Style="{StaticResource Hint}" Margin="0,8,0,0"
                                   TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <StackPanel x:Name="LegacyAudioPanel" Margin="0,8,0,0">
                        <TextBlock x:Name="AudioHint" Style="{StaticResource Hint}" TextWrapping="Wrap"
                                   Text="Clips get a separate track for each source, named in the editor, so you can set their volumes or merge them when exporting." />
                        <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="SplitChatCheck" Margin="0,12,0,0" Checked="Changed" Unchecked="Changed">
                            <TextBlock Text="Separate voice chat" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock x:Name="ChatText" Margin="28,4,0,0" Style="{StaticResource Hint}" />
                        <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="SplitMusicCheck" Margin="0,10,0,0" Checked="Changed" Unchecked="Changed">
                            <TextBlock Text="Separate music" TextWrapping="Wrap" />
                        </CheckBox>
                        <TextBlock x:Name="MusicText" Margin="28,4,0,0" Style="{StaticResource Hint}" />

                        <Grid Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="MicCheck" Content="Microphone" VerticalAlignment="Top" Checked="Changed" Unchecked="Changed" />
                            <StackPanel Grid.Column="1">
                                <!-- A row per microphone, filled in by the code -->
                                <StackPanel x:Name="MicList" />
                                <Button x:Name="AddMicButton" Style="{StaticResource TextButton}" Content="Add another microphone" HorizontalAlignment="Left"
                                        Margin="0,8,0,0" Click="AddMic_Click" />
                            </StackPanel>
                        </Grid>

                        <Grid x:Name="MicTracksRow" Style="{StaticResource Row}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Microphone tracks" VerticalAlignment="Center"  TextWrapping="Wrap" />
                            <ComboBox x:Name="MicTracksCombo" Grid.Column="1" SelectionChanged="Changed" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Hotkey -->
            <Border x:Name="HotkeysCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Recording hotkeys" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="Select a shortcut to change it. Clear leaves it unbound. Reset restores that command’s default."
                               Style="{StaticResource Hint}" Margin="0,4,0,0" />
                    <StackPanel x:Name="HotkeyRows" />
                </StackPanel>
            </Border>

            <!-- Sharing -->
            <Border x:Name="SharingCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Sharing" Style="{StaticResource CardTitle}" />
                    <TextBlock Style="{StaticResource Hint}" Margin="0,2,0,0" TextWrapping="Wrap"
                               Text="Prepare an MP4 with one soundtrack and paste it or attach it manually. Temporary shared copies expire after 24 hours, except files still on the clipboard." />
                    <Button Content="Manage sharing profiles…" HorizontalAlignment="Left" Margin="0,8,0,0"
                            Click="SharingProfiles_Click" />
                    <TextBlock x:Name="DefaultSharingText" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <CheckBox x:Name="ParallelMediaJobs" Margin="0,10,0,0" Checked="MediaConcurrency_Changed" Unchecked="MediaConcurrency_Changed"
                              Content="Allow two background media jobs when idle" />
                    <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="MotionBlurCheck" Margin="0,10,0,0" Checked="Changed" Unchecked="Changed">
                        <TextBlock Text="Smooth motion: blend the extra frames of clips over 60 fps (like 120 fps) into motion blur" TextWrapping="Wrap" />
                    </CheckBox>
                    <TextBlock Style="{StaticResource Hint}" Margin="28,2,0,0" TextWrapping="Wrap"
                               Text="The 60 fps copy looks smoother than one that just drops every other frame. Sharing takes a little longer." />
                </StackPanel>
            </Border>

            <!-- General -->
            <Border x:Name="GeneralCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="General" Style="{StaticResource CardTitle}" />
                    <StackPanel x:Name="GeneralPreferences">
                      <views:AppearanceSettings x:Name="Appearance" Margin="0,10,0,0" />
                    <StackPanel x:Name="InterfaceSettings" Margin="0,6,0,10">
                        <TextBlock Text="Interface scale" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="CombinedScale" AutomationProperties.Name="Interface scale" MinWidth="120"
                                  SelectionChanged="Scale_Changed" HorizontalAlignment="Left" ItemStringFormat="{}{0}%" />
                        <TextBlock Text="Changes text and controls together. A blank selection means they use different sizes." Style="{StaticResource Hint}" Margin="0,3,0,0" />
                        <WrapPanel Margin="0,4,0,0">
                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="Text size" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="TextScale" AutomationProperties.Name="Text size" MinWidth="120"
                                          SelectionChanged="Scale_Changed" ItemStringFormat="{}{0}%" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="Buttons and controls size" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="ControlScale" AutomationProperties.Name="Buttons and controls size" MinWidth="120"
                                          SelectionChanged="Scale_Changed" ItemStringFormat="{}{0}%" />
                            </StackPanel>
                            <Button Content="Reset scale" Click="ResetScale_Click" VerticalAlignment="Bottom" Margin="0,0,0,6" />
                        </WrapPanel>
                    </StackPanel>
                    <TextBlock Text="External player" Style="{StaticResource FieldLabel}" />
                    <DockPanel Margin="0,2,0,6">
                        <Button DockPanel.Dock="Right" Content="Change…" Click="ExternalPlayer_Choose" Margin="8,0,0,0"
                                AutomationProperties.Name="Change default external player" />
                        <TextBlock x:Name="ExternalPlayerText" VerticalAlignment="Center" TextWrapping="Wrap"
                                   AutomationProperties.Name="Current external player" />
                    </DockPanel>
                    <TextBlock Text="Used when opening a saved clip outside QuickClip. Windows file associations stay unchanged."
                               Style="{StaticResource Hint}" />
                    <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="StartupCheck" Content="Start QuickClip with Windows" Margin="0,10,0,0"
                              Checked="Startup_Changed" Unchecked="Startup_Changed" />
                    <TextBlock x:Name="StartupHint" Style="{StaticResource Hint}" Margin="0,4,0,0" Visibility="Collapsed" />
                    <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="ReplayAtStartupCheck" Content="Enable Instant Replay when QuickClip starts"
                              Margin="0,8,0,0" Visibility="Collapsed" Checked="ReplayStartup_Changed" Unchecked="ReplayStartup_Changed" />
                    <TextBlock x:Name="ReplayAtStartupHint" Style="{StaticResource Hint}" Margin="0,4,0,0" Visibility="Collapsed"
                               Text="Applies next launch. QuickClip waits for an eligible game and uses your existing display permissions." />
                    <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="StartTrayCheck" Content="Start in the tray when Windows starts QuickClip" Margin="0,8,0,0" Checked="Changed" Unchecked="Changed" />
                    <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="CloseTrayCheck" Margin="0,8,0,0" Checked="Changed" Unchecked="Changed">
                        <TextBlock Text="Closing the window keeps QuickClip running in the tray" TextWrapping="Wrap" />
                    </CheckBox>
                    <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="ConfirmDeleteCheck" Content="Confirm before sending clips to the Recycle Bin" Margin="0,8,0,0" Checked="Changed" Unchecked="Changed" />
                    <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="ConfirmSaveOverCheck" Content="Confirm before replacing the original clip" Margin="0,8,0,0" Checked="Changed" Unchecked="Changed" />
                    <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="ShellCheck" Margin="0,8,0,0" Checked="ShellCheck_Changed" Unchecked="ShellCheck_Changed">
                        <TextBlock Text="Add &quot;Edit with QuickClip&quot; to the right-click menu of video and audio files" TextWrapping="Wrap" />
                    </CheckBox>
                    </StackPanel>
                </StackPanel>
            </Border>
            <!-- Explicitly scoped companion capture; never bundled with display permissions. -->
            <Border x:Name="CompanionsCard" Style="{StaticResource Card}" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="Discord" Style="{StaticResource CardTitle}" />
                    <CheckBox x:Name="DiscordEnableCheck" Content="Capture Discord"
                              Style="{StaticResource SwitchCheckBox}" Margin="0,10,0,6"
                              Click="DiscordOption_Click"
                              ToolTip="Allow QuickClip to record Discord's windows without recording the desktop" />
                    <TextBlock Text="When to capture" Margin="0,8,0,5" FontWeight="SemiBold" />
                    <ComboBox x:Name="DiscordModeCombo" SelectionChanged="DiscordMode_Changed"
                              AutomationProperties.Name="When to capture Discord" ToolTip="Discord recording starts only when QuickClip recording is enabled">
                        <ComboBoxItem Content="During voice and video calls" Tag="DuringCalls"/>
                        <ComboBoxItem Content="While Discord is open" Tag="WhileOpen"/>
                        <ComboBoxItem Content="Only when I start it" Tag="Manual"/>
                    </ComboBox>
                    <TextBlock x:Name="DiscordWindowScopeHint"
                               Text="All visible Discord windows, including popped-out streams and cameras, share one recording. Games take priority."
                               Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,9,0,4" />
                    <CheckBox x:Name="DiscordMirrorCheck"
                              Content="Experimental borderless Discord mirror (Windows 10)"
                              Style="{StaticResource SwitchCheckBox}" Margin="0,8,0,3"
                              Visibility="Collapsed" Click="DiscordOption_Click"
                              ToolTip="Uses an application-cloaked DWM host; output may have padding after resizing" />
                    <TextBlock x:Name="DiscordMirrorHint" Visibility="Collapsed" Style="{StaticResource Hint}"
                               Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,5,0,5"
                               Text="Experimental on Windows 10: mirrors each authorized Discord window through a cloaked host, then uses the normal Discord multi-window layout. No visible capture outline was observed on the tested system; driver compatibility and GPU cost remain unverified. Aspect ratios are preserved when resizing." />
                    <TextBlock x:Name="DiscordBorderNotice" Visibility="Collapsed" Style="{StaticResource Hint}"
                               Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap" Margin="0,7,0,5"
                               Text="Windows 10 adds a yellow capture outline around each Discord window. Windows 10 does not provide an approved way for QuickClip to hide it with this capture method." />
                    <Border Background="{DynamicResource ElevatedSurfaceBrush}" CornerRadius="7" Padding="10,8" Margin="0,7,0,7">
                        <StackPanel>
                            <TextBlock Text="Privacy" FontWeight="SemiBold"/>
                            <TextBlock Text="Discord messages and profiles may appear in your clip. No other applications or desktops are captured."
                                       Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,3,0,0" />
                        </StackPanel>
                    </Border>
                    <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                        <Button x:Name="DiscordManualButton" Visibility="Collapsed" Content="Start Discord capture"
                                Margin="0,0,9,5" Click="DiscordManual_Click"
                                ToolTip="Manually start or stop Discord replay capture" />
                        <TextBlock x:Name="DiscordStatusText" Text="Off" VerticalAlignment="Center"
                                   Foreground="{DynamicResource SecondaryTextBrush}" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                    </WrapPanel>
                    <TextBlock Text="Your selected playback and microphone tracks are used once, regardless of how many windows Discord opens."
                               Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
            <Border x:Name="NotificationsCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Notifications" Style="{StaticResource CardTitle}" />
                    <WrapPanel Margin="0,8,0,0">
                        <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="SoundCheck" Focusable="True" Content="Play a sound when a clip is saved" VerticalAlignment="Center" Checked="Changed" Unchecked="Changed" />
                        <Button Style="{StaticResource TextButton}" Content="Test sound" ToolTip="Hear the sound" Margin="10,0,0,0" VerticalAlignment="Center"
                                Focusable="True" Click="PlayClipSound_Click" />
                    </WrapPanel>
                    <StackPanel x:Name="SoundOutputPanel" Margin="0,4,0,0">
                        <TextBlock Text="Clip save sound" Style="{StaticResource FieldLabel}" />
                        <WrapPanel>
                            <Button x:Name="ChooseClipSoundButton" Content="Choose custom sound…" Style="{StaticResource TextButton}"
                                    Click="ChooseClipSound_Click" />
                            <Button x:Name="ResetClipSoundButton" Content="Use default shutter" Style="{StaticResource TextButton}"
                                    Click="ResetClipSound_Click" />
                        </WrapPanel>
                        <TextBlock x:Name="SelectedClipSound" Style="{StaticResource Hint}" TextWrapping="Wrap"
                                   AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="ClipSoundFileError" Foreground="{DynamicResource DangerBrush}"
                                   FontWeight="SemiBold" TextWrapping="Wrap" Visibility="Collapsed"
                                   AutomationProperties.LiveSetting="Assertive" />
                        <TextBlock Style="{StaticResource Hint}" Text="Supports local WAV, MP3, FLAC, OGG/Opus, M4A, AAC, AIFF; up to 16 MiB. Only the first 3 seconds play." />
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock DockPanel.Dock="Right" Margin="8,0,0,0" VerticalAlignment="Center"
                                       Text="{Binding Value, ElementName=SoundVolumeSlider, StringFormat={}{0:0}%}"  TextWrapping="Wrap" />
                            <Slider x:Name="SoundVolumeSlider" Minimum="0" Maximum="100" TickFrequency="1"
                                    IsSnapToTickEnabled="True" ValueChanged="SoundVolumeChanged" AutomationProperties.Name="Notification sound volume" />
                        </DockPanel>
                        <TextBlock Text="Clip sound output" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="SoundOutputCombo" AutomationProperties.Name="Clip sound output"
                                  DropDownOpened="SoundOutputOpened" SelectionChanged="SoundOutputChanged" />
                        <TextBlock x:Name="SoundOutputStatus" Style="{StaticResource Hint}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite" />
                    </StackPanel>
                    <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="WindowsClipNotificationCheck" Content="Show Windows clip notifications"
                              Margin="0,8,0,0" Click="ClipFeedback_Changed" />

                    <StackPanel x:Name="ClipOverlayPanel" Margin="0,12,0,0">
                        <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="ClipNotificationsCheck" Content="Show visual notifications" Focusable="True" Click="ClipFeedback_Changed" />
                        <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="GameIndicatorCheck" Content="Recording status icons (can appear in footage)" Focusable="True" Margin="0,8,0,0" Click="ClipFeedback_Changed" />
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="Small replay and microphone icons on the recorded display. Enable them to show ordinary icons that can appear in footage." />
                        <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="MicrophoneIndicatorCheck" Content="Show microphone signal status" Focusable="True" Margin="0,8,0,0" Click="ClipFeedback_Changed" />
                        <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Text="The replay icon shows a recording is active. Microphone icon: red until the selected mic has been heard, then white; hidden when no mic is selected." />
                        <Border x:Name="FeedbackVisualGuide" Visibility="Collapsed" Background="{DynamicResource ElevatedSurfaceBrush}"
                                BorderBrush="{DynamicResource DividerBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,12,0,10">
                            <StackPanel>
                                <TextBlock Text="This is what you'll see" FontSize="{DynamicResource QuickClipText16}" FontWeight="SemiBold" Margin="0,0,0,9" />
                                <WrapPanel>
                                    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="1" CornerRadius="7" Padding="11,8" MinWidth="192" Margin="0,0,10,8">
                                        <StackPanel>
                                            <TextBlock Text="Recording status" FontWeight="SemiBold" />
                                            <StackPanel x:Name="FeedbackIndicatorIcons" Orientation="Horizontal" Margin="0,9,0,6" />
                                            <TextBlock Text="Camera = replay; mic red until verified, then white." Style="{StaticResource Hint}" TextWrapping="Wrap" />
                                            <TextBlock Text="Shown at the chosen corner of the active display." Style="{StaticResource Hint}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="FeedbackSavedExample" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}"
                                            BorderThickness="1" CornerRadius="7" Padding="11,8" MinWidth="220" Margin="0,0,0,8">
                                        <StackPanel>
                                            <TextBlock Text="Saved clip" FontWeight="SemiBold" />
                                            <Border Background="{DynamicResource CardBrush}" CornerRadius="6" Padding="9" Margin="0,7,0,5">
                                                <StackPanel>
                                                    <TextBlock Text="Clip saved" FontWeight="SemiBold" />
                                                    <TextBlock Text="Example clip · 30 s · 1080p" Style="{StaticResource Hint}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="Preview uses your selected position" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                                <TextBlock Text="Status icons use the real QuickClip HUD artwork. Saved-clip example is illustrative."
                                           Style="{StaticResource Hint}" TextWrapping="Wrap" />
                                <TextBlock x:Name="FeedbackStateSummary" Style="{StaticResource Hint}" FontWeight="SemiBold"
                                           TextWrapping="Wrap" Margin="0,6,0,0" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </Border>
                        <StackPanel x:Name="AdvancedNotificationOptions">
                        <ComboBox x:Name="GameIndicatorAnchorCombo" AutomationProperties.Name="Recording status position" SelectionChanged="ClipFeedback_Changed" Margin="0,4,0,0" />
                        <Button Content="Preview recording icons" HorizontalAlignment="Left" Margin="0,6,0,0"
                                ToolTip="Shows QuickClip status icons for four seconds without recording." Click="PreviewRecordingIndicator_Click" />
                        <TextBlock x:Name="GameIndicatorStatus" TextWrapping="Wrap" Style="{StaticResource Hint}" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="Notification channels" Style="{StaticResource FieldLabel}" />
                        <ComboBox x:Name="ClipNotificationModeCombo" AutomationProperties.Name="Notification channels" SelectionChanged="ClipFeedback_Changed" />
                        <TextBlock Text="Choose where status messages appear. The image and save sound have their own switches." Style="{StaticResource Hint}" Margin="0,4,0,0" />
                        <StackPanel x:Name="ClipEventsPanel" Margin="0,8,0,0">
                            <TextBlock Text="Notify me when" Style="{StaticResource FieldLabel}" />
                            <UniformGrid Columns="2">
                                <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="ReplayEnabledNotice" Content="Instant replay is enabled" Focusable="True" Margin="0,0,12,4" Click="ClipFeedback_Changed" />
                                <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="ClipSavedNotice" Content="A clip is saved (text notification)" Focusable="True" Margin="0,0,12,4" Click="ClipFeedback_Changed" />
                                <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="GameStartedNotice" Content="Game recording starts" Focusable="True" Margin="0,0,12,4" Click="ClipFeedback_Changed" />
                                <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="DesktopStartedNotice" Content="Desktop recording starts" Focusable="True" Margin="0,0,12,4" Click="ClipFeedback_Changed" />
                                <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="DesktopStoppedNotice" Content="Desktop recording stops" Focusable="True" Margin="0,0,12,4" Click="ClipFeedback_Changed" />
                                <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="SaveFailedNotice" Content="Saving fails" Focusable="True" Margin="0,0,12,4" Click="ClipFeedback_Changed" />
                                <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="IdleSaveNotificationCheck" Content="Save Clip is pressed without active recording" Focusable="True" Margin="0,0,12,4" Click="ClipFeedback_Changed" />
                            </UniformGrid>
                        </StackPanel>
                        <StackPanel x:Name="ClipOverlayOptions" Margin="0,8,0,0" Visibility="Collapsed">
                            <Border Background="{DynamicResource ElevatedSurfaceBrush}" CornerRadius="10" Padding="14" Margin="0,6,0,10">
                                <StackPanel>
                                    <TextBlock Text="Clip saved" FontWeight="SemiBold" FontSize="{DynamicResource QuickClipText16}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Image and text notifications are independent. Turn off the clip-saved text notification above to keep only the image, sound, or both." Margin="0,4,0,8" />
                                    <CheckBox x:Name="ImageOnlyCheck" Style="{StaticResource SwitchCheckBox}" Content="Show an image or animation when a clip is saved" Click="ClipFeedback_Changed" />
                                    <CheckBox x:Name="ShowSavedBannerInCaptureCheck" Style="{StaticResource SwitchCheckBox}" Margin="0,6,0,0" Click="ClipFeedback_Changed">
                                        <TextBlock Text="Show saved banner on screen, including in recordings" TextWrapping="Wrap" />
                                    </CheckBox>
                                    <TextBlock Style="{StaticResource Hint}" Margin="0,4,0,0"
                                               Text="Capture exclusion was retired after it left black patches. Previously excluded banners stay off until you enable them here. Windows notifications, images and sound have separate controls." />
                                    <TextBlock x:Name="OverlayOverlapWarning" Foreground="{DynamicResource WarningBrush}" TextWrapping="Wrap"
                                               FontSize="{DynamicResource QuickClipText12}" Margin="0,6,0,0" Visibility="Collapsed"
                                               Text="Both notifications use the same display and position. The image may cover part of the banner." />
                                    <StackPanel x:Name="ImageAppearancePanel" Visibility="Collapsed">
                            <WrapPanel Margin="0,8,0,0">
                                <Button Content="Choose image / WebM animation…" Margin="0,0,8,0" Click="ChooseOverlayImage_Click" />
                                <Button x:Name="ClearOverlayImage" Content="Use default animation" Click="ClearOverlayImage_Click" />
                            </WrapPanel>
                            <TextBlock x:Name="OverlayImageStatus" Style="{StaticResource Hint}" AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="Image fit" Margin="0,8,0,0" />
                            <ComboBox x:Name="OverlayImageFitCombo" SelectionChanged="ClipFeedback_Changed"
                                      AutomationProperties.Name="Image fit or cropped fill" />
                            <TextBlock x:Name="OverlayImageError" Foreground="{DynamicResource DangerBrush}"
                                       FontWeight="SemiBold" FontSize="{DynamicResource QuickClipText14}" TextWrapping="Wrap"
                                       Visibility="Collapsed" AutomationProperties.LiveSetting="Assertive" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Display" />
                                    <ComboBox x:Name="ImageOverlayDisplayCombo" SelectionChanged="ClipFeedback_Changed" AutomationProperties.Name="Image display" />
                                    <TextBlock Text="Position" Margin="0,8,0,0" />
                                    <ComboBox x:Name="ImageOverlayAnchorCombo" SelectionChanged="ClipFeedback_Changed" AutomationProperties.Name="Image position" />
                                    <TextBlock Text="Animation" Margin="0,8,0,0" />
                                    <ComboBox x:Name="ImageOverlayAnimationCombo" SelectionChanged="ClipFeedback_Changed" AutomationProperties.Name="Image animation" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Size (DIP, 24–240)" TextWrapping="Wrap" />
                                    <TextBox x:Name="ImageOverlaySizeBox" TextChanged="ClipFeedback_Changed" AutomationProperties.Name="Image size in device-independent pixels" />
                                    <TextBlock x:Name="ImageOverlaySizeError" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="Opacity" Margin="0,8,0,0" />
                                    <ComboBox x:Name="ImageOverlayOpacityCombo" SelectionChanged="ClipFeedback_Changed" AutomationProperties.Name="Image opacity" />
                                    <TextBlock Text="Image duration in seconds (0.6–60)" Margin="0,8,0,0" />
                                    <TextBox x:Name="ImageOverlayDurationBox" TextChanged="ClipFeedback_Changed"
                                             AutomationProperties.Name="Image duration in seconds" />
                                    <TextBlock x:Name="ImageOverlayDurationError" Foreground="{DynamicResource DangerBrush}"
                                               FontWeight="SemiBold" TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Grid>

                                        <Button Content="Preview clip image" HorizontalAlignment="Left" Margin="0,10,0,0" Click="TestClipImage_Click" />
                                    </StackPanel>
                                    <StackPanel x:Name="SavedBannerPanel">
                                        <CheckBox x:Name="DetailedSavedCheck" Style="{StaticResource SwitchCheckBox}" Content="Use detailed banner for clip saved" Click="ClipFeedback_Changed" />
                                        <StackPanel x:Name="OverlayDetailsPanel">
                            <TextBlock Text="Overlay details" Style="{StaticResource FieldLabel}" />
                            <WrapPanel>
                                <CheckBox x:Name="OverlayShowTitle" Content="Clip title" Focusable="True" Margin="0,0,14,0" Click="ClipFeedback_Changed" />
                                <CheckBox x:Name="OverlayShowGame" Content="Game" Focusable="True" Margin="0,0,14,0" Click="ClipFeedback_Changed" />
                                <CheckBox x:Name="OverlayShowSource" Content="Source" Focusable="True" Margin="0,0,14,0" Click="ClipFeedback_Changed" />
                                <CheckBox x:Name="OverlayShowDuration" Content="Duration" Focusable="True" Margin="0,0,14,0" Click="ClipFeedback_Changed" />
                                <CheckBox x:Name="OverlayShowResolution" Content="Resolution" Focusable="True" Margin="0,0,14,0" Click="ClipFeedback_Changed" />
                                <CheckBox x:Name="OverlayShowFps" Content="FPS" Focusable="True" Margin="0,0,14,0" Click="ClipFeedback_Changed" />
                                <CheckBox x:Name="OverlayShowHotkey" Content="Save hotkey hint" Focusable="True" Click="ClipFeedback_Changed" />
                            </WrapPanel>
                                        </StackPanel>
                                        <Button Content="Preview clip saved banner" HorizontalAlignment="Left" Margin="0,8,0,0" Click="TestSavedBanner_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border x:Name="BannerAppearancePanel" Background="{DynamicResource ElevatedSurfaceBrush}" CornerRadius="10" Padding="14" Margin="0,0,0,10">
                                <StackPanel>
                                    <TextBlock Text="On-screen banners" FontWeight="SemiBold" FontSize="{DynamicResource QuickClipText16}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="Short status messages, no custom images. These settings are independent of the clip image." Margin="0,4,0,0" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,6,0">
                                    <TextBlock Text="Display" />
                                    <ComboBox x:Name="OverlayDisplayCombo" SelectionChanged="ClipFeedback_Changed" AutomationProperties.Name="Indicator display" />
                                    <TextBlock Text="Position" Margin="0,8,0,0" />
                                    <ComboBox x:Name="OverlayAnchorCombo" SelectionChanged="ClipFeedback_Changed" AutomationProperties.Name="Indicator position" />
                                    <TextBlock Text="Animation" Margin="0,8,0,0" />
                                    <ComboBox x:Name="OverlayAnimationCombo" SelectionChanged="ClipFeedback_Changed" AutomationProperties.Name="Indicator animation" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="6,0,0,0">
                                    <TextBlock Text="Size (DIP, 24–240)" TextWrapping="Wrap" />
                                    <TextBox x:Name="OverlaySizeBox" TextChanged="ClipFeedback_Changed" AutomationProperties.Name="Banner size in device-independent pixels" />
                                    <TextBlock x:Name="OverlaySizeError" Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                                    <TextBlock Text="Opacity" Margin="0,8,0,0" />
                                    <ComboBox x:Name="OverlayOpacityCombo" SelectionChanged="ClipFeedback_Changed" AutomationProperties.Name="Indicator opacity" />
                                    <TextBlock Text="Duration in seconds (0.6–60)" Margin="0,8,0,0" />
                                    <TextBox x:Name="OverlayDurationBox" TextChanged="ClipFeedback_Changed"
                                             AutomationProperties.Name="Indicator duration in seconds" />
                                    <TextBlock x:Name="OverlayDurationError" Foreground="{DynamicResource DangerBrush}"
                                               FontWeight="SemiBold" TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Grid>

                                    <Button Content="Preview compact banner" HorizontalAlignment="Left" Margin="0,10,0,0" Click="TestCompactBanner_Click" />
                                </StackPanel>
                            </Border>
                            <Button Content="Reset notification appearance" HorizontalAlignment="Left" Margin="0,0,0,8" Click="ResetClipOverlay_Click" />
                            <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                       Text="Visible over windowed and borderless games. Exclusive fullscreen and capture exclusion depend on Windows and the capture backend." />
                        </StackPanel>
                    </StackPanel>
                    </StackPanel>
                    <WrapPanel x:Name="BasicNotificationPreview" Visibility="Collapsed" Margin="0,6,0,0">
                        <Button Content="Preview clip saved" Click="TestClipOverlay_Click" Margin="0,0,8,4"
                                ToolTip="Shows an example without saving a clip or sending a Windows notification." />
                        <Button Content="Preview status banner" Click="TestCompactBanner_Click" Margin="0,0,8,4" />
                    </WrapPanel>


                </StackPanel>
            </Border>
            <Border x:Name="LibraryCard" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="Saved recordings location" Style="{StaticResource CardTitle}" />
                    <TextBlock Text="New recordings are saved here. Gallery can also show clips from additional sources." Style="{StaticResource Hint}" />
                    <Grid Style="{StaticResource Row}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="FolderBox" IsReadOnly="True" Style="{StaticResource CompactBox}" Padding="8,6"
                                 AutomationProperties.Name="Saved recordings location" />
                        <Button Grid.Column="1" Content="Change…" Margin="8,0,0,0" Click="ChangeFolder_Click" />
                    </Grid>
                    <DockPanel Margin="0,6,0,0">
                        <Button DockPanel.Dock="Right" Content="Open folder" Click="OpenRecordingFolder_Click" />
                        <TextBlock x:Name="RecordingFreeSpace" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                    </DockPanel>
                    <ContentControl x:Name="LibraryDriveUsage" ContentTemplate="{StaticResource DriveUsageTemplate}" />
                    <StackPanel x:Name="LibraryOptions" Margin="0,16,0,0">
                        <TextBlock Text="Additional Gallery sources" FontWeight="SemiBold" />
                        <TextBlock Text="These folders stay visible in Gallery. New recordings go to the location above." Style="{StaticResource Hint}" />
                        <ListBox x:Name="AdditionalSourcesList" Margin="0,6,0,0" MaxHeight="180"
                                 AutomationProperties.Name="Additional Gallery sources" />
                        <WrapPanel Margin="0,6,0,12">
                            <Button Content="Add existing folder…" Click="AddClipSource_Click" Margin="0,0,8,4" />
                            <Button Content="Remove from Gallery…" Click="RemoveClipSource_Click" Margin="0,0,8,4" />
                        </WrapPanel>
                        <CheckBox Style="{StaticResource SwitchCheckBox}" x:Name="IndexLibraryCheck" Content="Smart library catalog"
                                  Click="IndexLibrary_Click" Margin="0,0,0,4" />
                        <TextBlock Style="{StaticResource Hint}" Text="Required for labels and library organization. Files stay unchanged." Margin="0,0,0,12" />
                        <TextBlock Text="Clip filename template" />
                        <TextBox x:Name="FilenameTemplate" Margin="0,5,0,0" TextChanged="FilenameTemplate_Changed"
                                 LostKeyboardFocus="FilenameTemplate_Commit" />
                        <TextBlock x:Name="FilenamePreview" Margin="0,5,0,0" Style="{StaticResource Hint}" TextWrapping="Wrap" />
                        <TextBlock Text="Hide folders from Gallery" Margin="0,12,0,0" TextWrapping="Wrap" />
                        <TextBox x:Name="ExclusionsBox" Margin="0,5,0,0" AcceptsReturn="True" MinHeight="50"
                                 LostKeyboardFocus="Exclusions_Commit" />
                        <TextBlock Style="{StaticResource Hint}" Margin="0,6,0,0" Text="Enter one folder path per line, without the drive or source folder. For Gallery sources E:\Clips and D:\Videos, entering Archive hides E:\Clips\Archive and D:\Videos\Archive. Entering Terraria\Old hides those nested folders; entering Drafts hides Drafts under each source. Files are not deleted." />
                    </StackPanel>
                </StackPanel>
            </Border>
            </controls:ResponsiveCards>
        </StackPanel>
        </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
