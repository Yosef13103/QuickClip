<UserControl x:Class="QuickClip.Views.CustomThemeEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Label Content="Theme _name" Target="{Binding ElementName=NameBox}" Padding="0,0,0,4" />
        <TextBox x:Name="NameBox" MaxLength="48" HorizontalAlignment="Left" MinWidth="240"
                 TextChanged="Name_Changed" AutomationProperties.Name="Theme name" />
        <Label Content="_Color" Target="{Binding ElementName=ColorPicker}" Padding="0,10,0,4" />
        <WrapPanel>
            <ComboBox x:Name="ColorPicker" MinWidth="145" Margin="0,0,6,6" SelectionChanged="Color_Changed"
                      AutomationProperties.Name="Semantic color" />
            <Button x:Name="Swatch" MinWidth="75" Margin="0,0,6,6" Content="Pick color" Click="PickColor_Click" />
            <TextBox x:Name="HexBox" MaxLength="7" MinWidth="90" Margin="0,0,6,6" TextChanged="Hex_Changed"
                     AutomationProperties.Name="Hexadecimal color, number sign followed by six digits" />
            <Button Margin="0,0,0,6" Content="Reset color" Click="ResetColor_Click" />
        </WrapPanel>
        <Border x:Name="Preview" Padding="12" CornerRadius="6" BorderThickness="1"
                BorderBrush="{DynamicResource BorderBrush}" Margin="0,4,0,0">
            <StackPanel>
                <TextBlock x:Name="PreviewPrimary" Text="QuickClip Personal" FontWeight="SemiBold" />
                <TextBlock x:Name="PreviewSecondary" Text="Waiting for a game" Margin="0,4,0,8" />
                <Border x:Name="PreviewAccent" HorizontalAlignment="Left" CornerRadius="4" Padding="10,5">
                    <TextBlock x:Name="PreviewAccentText" Text="Save clip" />
                </Border>
            </StackPanel>
        </Border>
        <TextBlock x:Name="Feedback" TextWrapping="Wrap" Margin="0,7,0,0" AutomationProperties.LiveSetting="Polite" />
        <WrapPanel Margin="0,8,0,0">
            <Button x:Name="SaveButton" Content="Save custom theme" Margin="0,0,6,6" Click="Save_Click" />
            <Button Content="Restore defaults" Margin="0,0,6,6" Click="Restore_Click" />
            <Button Content="Import JSON…" Margin="0,0,6,6" Click="Import_Click" />
            <Button x:Name="ExportButton" Content="Export JSON…" Margin="0,0,0,6" Click="Export_Click" />
        </WrapPanel>
    </StackPanel>
</UserControl>
