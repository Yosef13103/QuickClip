<UserControl x:Class="QuickClip.Views.GalleryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gallery="clr-namespace:QuickClip.Gallery"
             xmlns:views="clr-namespace:QuickClip.Views">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuickClip;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="ShowIf" />
            <Style x:Key="GalleryDeleteButton" TargetType="Button" BasedOn="{StaticResource TextButton}">
                <Setter Property="Focusable" Value="True" />
                <Setter Property="Background" Value="#AE2D37" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Padding" Value="11,6" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4"
                                    Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="#C33744" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="White" />
                                    <Setter TargetName="Surface" Property="Background" Value="#C33744" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="#8C222C" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="ClipCard" DataType="{x:Type gallery:ClipItem}">
                <Border x:Name="Card" Width="{Binding CardWidth, RelativeSource={RelativeSource AncestorType=views:GalleryView}}"
                        Margin="0,0,14,16" CornerRadius="8" Background="{StaticResource CardBrush}"
                        Focusable="True" AutomationProperties.Name="{Binding Title}" KeyDown="Card_KeyDown"
                        BorderThickness="1" BorderBrush="Transparent" Cursor="Hand"
                        MouseLeftButtonUp="Card_MouseLeftButtonUp" Loaded="Card_Loaded" DataContextChanged="Card_DataContextChanged"
                        PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown" MouseMove="Card_MouseMove">
                    <Border.ContextMenu>
                        <ContextMenu Opened="ClipMenu_Opened" DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                            <MenuItem Header="Watch and edit" Click="OpenClip_Click" FontWeight="SemiBold" />
                            <MenuItem Header="Share (copy to clipboard)" Click="ShareClip_Click" ToolTip="Share: makes a copy under the size limit in Settings (at most 60 fps, all audio mixed into one track) and copies it to the clipboard to paste anywhere. The original stays as it is." />
                            <MenuItem Header="Open classic player" Click="PlayClip_Click" />
                            <MenuItem Header="Edit title, game or tags…" Click="EditClipDetails_Click" Tag="details" />
                            <MenuItem Header="Add to favorites" Click="FavoriteMenu_Click" Tag="favorite" />
                            <Separator />
                            <!-- Filled in when the menu opens: every project, then New project -->
                            <MenuItem Header="Add to project" Tag="projects">
                                <MenuItem Header="New project…" />
                            </MenuItem>
                            <MenuItem Header="Copy to folder…" Tag="copy" Click="CopyClipsToFolder_Click" />
                            <Separator />
                            <MenuItem Header="Open with default app" Click="OpenWith_Click" />
                            <MenuItem Header="Show in Explorer" Click="RevealClip_Click" />
                            <Separator />
                            <MenuItem Header="Select" Click="SelectClip_Click" />
                            <Separator />
                            <MenuItem Header="Delete" Click="DeleteClip_Click" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <StackPanel>
                        <Grid Height="{Binding PosterHeight, RelativeSource={RelativeSource AncestorType=views:GalleryView}}"
                              ClipToBounds="True" MouseEnter="Poster_MouseEnter" MouseLeave="Poster_MouseLeave"
                              Unloaded="Poster_MouseLeave" SizeChanged="Poster_SizeChanged">
                            <Border CornerRadius="7,7,0,0" Background="#111" />
                            <Border CornerRadius="7,7,0,0">
                                <Border.Background>
                                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                                </Border.Background>
                            </Border>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="7" Padding="6,1,6,2" CornerRadius="4"
                                    Background="#B0000000">
                                <TextBlock Text="{Binding DurationText}" FontSize="11.5" Foreground="White" />
                            </Border>
                            <!-- Ticks the clip for "Add to project" / "Copy to folder" -->
                            <Border x:Name="PickBox" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6" Padding="6,2,0,2" CornerRadius="5"
                                    Background="#A0000000" Visibility="Collapsed">
                                <CheckBox IsChecked="{Binding IsSelected}" MinHeight="0" ToolTip="Select (Ctrl+click a clip also selects it)" />
                            </Border>
                        </Grid>
                        <DockPanel Margin="11,8,11,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="8,0,0,0">
                                <Button Tag="{Binding IsFavorite}" Style="{StaticResource FavoriteButtonStyle}"
                                        Click="FavoriteCard_Click" VerticalAlignment="Center"
                                        Visibility="{Binding PersonalAnnotations, RelativeSource={RelativeSource AncestorType=views:GalleryView}, Converter={StaticResource ShowIf}}" />
                                <Button Content="&#xE72D;" Style="{StaticResource IconButton}" Click="ShareClip_Click"
                                        Focusable="True" VerticalAlignment="Center" AutomationProperties.Name="Share clip"
                                        ToolTip="Share clip · copy to clipboard" />
                                <Button Content="⋯" Style="{StaticResource TextButton}" Padding="5,2" Width="30" FontSize="15"
                                        Tag="{Binding ElementName=Card}" Click="ClipOverflow_Click"
                                        AutomationProperties.Name="Clip actions" ToolTip="Clip actions" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Folder}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding TagText}" ToolTip="{Binding TagText}" FontSize="12"
                                           Foreground="{StaticResource SubtleText}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TagText}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Margin="0,2,0,0" FontSize="12" Foreground="{StaticResource SubtleText}"
                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Created, StringFormat=F}">
                                    <Run Text="{Binding Created, Mode=OneWay, StringFormat=t}" /><Run Text="  ·  " />
                                    <Run Text="{Binding Ago, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding SizeText, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                    <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        <Setter TargetName="PickBox" Property="Visibility" Value="Visible" />
                    </Trigger>
                    <!-- While anything is selected every clip shows its checkbox, and clicking a clip ticks it -->
                    <DataTrigger Binding="{Binding HasSelection, RelativeSource={RelativeSource AncestorType=views:GalleryView}}" Value="True">
                        <Setter TargetName="PickBox" Property="Visibility" Value="Visible" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter TargetName="PickBox" Property="Visibility" Value="Visible" />
                        <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
            <DataTemplate DataType="{x:Type gallery:GalleryDayHeader}">
                <DockPanel Margin="0,12,14,8">
                    <CheckBox DockPanel.Dock="Left" IsThreeState="True" IsChecked="{Binding Selection, Mode=OneWay}"
                              Click="SelectDay_Click" VerticalAlignment="Center" Margin="0,0,9,0"
                              AutomationProperties.Name="{Binding SelectionLabel}" ToolTip="{Binding SelectionLabel}" />
                    <TextBlock DockPanel.Dock="Left" Text="{Binding Heading}" FontWeight="SemiBold" FontSize="15"
                               VerticalAlignment="Center" Margin="0,0,12,0" />
                    <TextBlock Text="{Binding Summary}" ToolTip="{Binding Summary}" TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" Style="{StaticResource Hint}" />
                </DockPanel>
            </DataTemplate>
            <DataTemplate DataType="{x:Type gallery:GalleryClipRow}">
                <ItemsControl ItemsSource="{Binding Clips}" ItemTemplate="{StaticResource ClipCard}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </DataTemplate>

            <!-- Lists in the side panel scroll with it rather than on their own -->
            <ControlTemplate x:Key="PlainList" TargetType="ListBox">
                <ItemsPresenter />
            </ControlTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Folders ("All clips" first, then a folder per game), then projects -->
        <Border Background="{StaticResource PanelBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="10,6,10,10">
                    <TextBlock Text="FOLDERS" Style="{StaticResource SectionHeader}" Margin="8,14,0,8" />
                    <ListBox x:Name="FolderList" Template="{StaticResource PlainList}" SelectionChanged="FolderList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding Count}" Foreground="{StaticResource SubtleText}" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <DockPanel Margin="8,22,0,6">
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;" FontSize="12" Padding="7,4" Margin="0"
                                Click="NewProject_Click" ToolTip="New project (or drop clips here to start one with them)"
                                AllowDrop="True" DragEnter="NewProject_DragOver" DragOver="NewProject_DragOver" Drop="NewProject_Drop" />
                        <TextBlock Text="PROJECTS" Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" />
                    </DockPanel>
                    <ListBox x:Name="ProjectList" Template="{StaticResource PlainList}" SelectionChanged="ProjectList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <!-- Clips dragged here from the gallery (or files from Explorer) are added to the project -->
                                <DockPanel Background="Transparent" AllowDrop="True" DragEnter="Project_DragOver" DragOver="Project_DragOver"
                                           DragLeave="Project_DragLeave" Drop="Project_Drop">
                                    <DockPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Rename…" Click="RenameProject_Click" />
                                            <MenuItem Header="Open folder" Click="OpenProjectFolder_Click" />
                                            <Separator />
                                            <MenuItem Header="Delete project" Click="DeleteProject_Click" />
                                        </ContextMenu>
                                    </DockPanel.ContextMenu>
                                    <TextBlock DockPanel.Dock="Right" Text="{Binding ClipCount}" Foreground="{StaticResource SubtleText}" Margin="8,0,0,0" />
                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock x:Name="NoProjectsText" Style="{StaticResource Hint}" Margin="8,2,8,0"
                               Text="Group clips for a montage: select clips, then Add to project, or drag clips onto the + above." />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1">
            <!-- Clips -->
            <DockPanel x:Name="ClipsPane" Margin="24,18,10,0">
                <DockPanel DockPanel.Dock="Top" Margin="0,0,14,12">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button x:Name="UndoDeleteButton" Content="Undo delete" Style="{StaticResource TextButton}" IsEnabled="False"
                                Click="UndoDelete_Click" ToolTip="Restore the latest deleted batch without overwriting files" />
                        <Button x:Name="StorageButton" Content="Storage" Style="{StaticResource TextButton}"
                                Click="OpenStorage_Click" ToolTip="Show indexed library storage" />
                        <Button Style="{StaticResource TextButton}" Click="OpenFolder_Click" ToolTip="Open this folder in Explorer">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE838;" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="Open folder" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource TextButton}" Click="OpenFile_Click" ToolTip="Edit any video or audio file">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8E5;" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <TextBlock Text="Open file…" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock x:Name="FolderTitle" Text="All clips" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock x:Name="FolderInfo" Margin="0,2,0,0" Style="{StaticResource Hint}" />
                    </StackPanel>
                </DockPanel>

                <!-- What to do with the selected clips -->
                <Border x:Name="SelectionBar" DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" CornerRadius="6" Padding="14,6,8,6"
                        Margin="0,0,14,14" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock x:Name="SelectionText" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,5" />
                        <WrapPanel x:Name="SelectionActions">
                            <Button x:Name="OrganizeSelectedButton" Content="Organize…" Style="{StaticResource TextButton}" Click="OrganizeSelected_Click"
                                    Visibility="{Binding PersonalAnnotations, RelativeSource={RelativeSource AncestorType=views:GalleryView}, Converter={StaticResource ShowIf}}" />
                            <Button x:Name="DeleteSelectedButton" Content="Delete selected…" Style="{StaticResource GalleryDeleteButton}" Click="DeleteSelected_Click"
                                    ToolTip="Delete selected clips visible in this view" />
                            <Button x:Name="AddToProjectButton" Style="{DynamicResource AccentButtonStyle}" Padding="12,5" Focusable="False"
                                    Click="AddToProject_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8F4;" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="Add to project" />
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE70D;" FontSize="10" VerticalAlignment="Center" Margin="8,1,0,0" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="CopySelectedButton" Style="{StaticResource TextButton}" Margin="8,0,4,0" Click="CopyToFolder_Click"
                                    ToolTip="Copy the selected clips to a folder of your choice">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE8C8;" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Text="Copy to folder…" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource TextButton}" Content="Select all matching" Click="SelectAll_Click" ToolTip="Select all clips visible in this view" />
                            <Button Style="{StaticResource TextButton}" Content="Clear selection" Margin="0" Click="ClearSelection_Click"
                                    ToolTip="Clear visible and hidden selections" />
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="StatusText" DockPanel.Dock="Top" Style="{StaticResource Hint}" Margin="0,-4,14,12" Visibility="Collapsed" />
                <WrapPanel x:Name="OrganizationFilters" DockPanel.Dock="Top" Margin="0,0,16,10">
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                            <TextBlock Text="Search" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="ClipSearchBox" Width="130" MaxLength="120" TextChanged="OrganizationFilter_Changed"
                                     AutomationProperties.Name="Search clip titles, filenames and games" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,10,4">
                            <TextBlock Text="Tag" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBox x:Name="TagSearchBox" Width="95" MaxLength="32" TextChanged="OrganizationFilter_Changed"
                                     AutomationProperties.Name="Filter by tag" />
                            <ComboBox x:Name="ExistingTagsCombo" Width="115" Margin="4,0,0,0" MaxDropDownHeight="250"
                                      AutomationProperties.Name="Browse existing tags" SelectionChanged="ExistingTags_Changed"
                                      ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True">
                                <ComboBox.ItemsPanel>
                                    <ItemsPanelTemplate><VirtualizingStackPanel /></ItemsPanelTemplate>
                                </ComboBox.ItemsPanel>
                            </ComboBox>
                        </StackPanel>
                        <CheckBox x:Name="FavoritesFilter" Content="Favorites only" VerticalAlignment="Center" Margin="0,0,10,4"
                                  Checked="OrganizationFilter_Changed" Unchecked="OrganizationFilter_Changed" />
                        <CheckBox x:Name="FavoritesSort" Content="Favorites first within each day" VerticalAlignment="Center" Margin="0,0,10,4"
                                  Checked="OrganizationFilter_Changed" Unchecked="OrganizationFilter_Changed" />
                        <Button Content="Clear filters" Click="ClearFilters_Click" Style="{StaticResource TextButton}" Margin="0,0,8,4" />
                </WrapPanel>
                <Border x:Name="InlineDetails" DockPanel.Dock="Top" Visibility="Collapsed"
                        Background="{StaticResource PanelBrush}" Padding="14,4" Margin="0,0,14,12">
                    <ScrollViewer MaxHeight="320" VerticalScrollBarVisibility="Auto">
                        <views:ClipDetailsEditor x:Name="GalleryDetailsEditor" />
                    </ScrollViewer>
                </Border>

                <Grid x:Name="ClipArea" SizeChanged="ClipArea_SizeChanged">
                    <ItemsControl x:Name="Rows" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  VirtualizingPanel.ScrollUnit="Pixel" ScrollViewer.CanContentScroll="True">
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer x:Name="GalleryScroll" CanContentScroll="True" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="420" Margin="0,0,0,80"
                                Visibility="Collapsed">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE714;" FontSize="40" HorizontalAlignment="Center"
                                   Foreground="{StaticResource SubtleText}" />
                        <TextBlock x:Name="EmptyTitle" Text="No clips yet" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,6" />
                        <TextBlock x:Name="EmptyText" Style="{StaticResource Hint}" TextAlignment="Center" />
                    </StackPanel>
                </Grid>
            </DockPanel>

            <!-- An open project -->
            <views:ProjectView x:Name="ProjectPane" Visibility="Collapsed" />
            <views:StorageDashboard x:Name="StoragePane" Visibility="Collapsed" />
        </Grid>
    </Grid>
</UserControl>
