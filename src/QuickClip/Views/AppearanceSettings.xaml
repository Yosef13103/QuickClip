<UserControl x:Class="QuickClip.Views.AppearanceSettings"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:QuickClip.Views">
    <StackPanel>
        <Label Content="_Theme" Target="{Binding ElementName=ThemePicker}" Padding="0,0,0,4" />
        <ComboBox x:Name="ThemePicker" HorizontalAlignment="Left" MinWidth="180" DisplayMemberPath="Label"
                  AutomationProperties.Name="Theme" SelectionChanged="ThemePicker_Changed" />
        <Expander Header="Custom palette" Margin="0,10,0,0">
            <views:CustomThemeEditor x:Name="CustomEditor" Margin="0,8,0,0" />
        </Expander>
    </StackPanel>
</UserControl>
