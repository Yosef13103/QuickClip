<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Shared by every page. Merged per view (not in App.xaml) so the Fluent theme's styles exist for BasedOn. -->
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="0,0,4,0" />
        <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
        <Setter Property="FontSize" Value="{DynamicResource QuickClipVisual15}" />
    </Style>
    <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="0,0,4,0" />
    </Style>
    <Style x:Key="IconToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Padding" Value="9,6" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
    </Style>
    <Style x:Key="FavoriteButtonStyle" TargetType="Button" BasedOn="{StaticResource IconButton}">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="AutomationProperties.Name" Value="Add to favorites" />
        <Setter Property="ToolTip" Value="Add to favorites" />
        <Setter Property="Content" Value="&#xE734;" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True">
                <Setter Property="Content" Value="&#xE735;" />
                <Setter Property="AutomationProperties.Name" Value="Remove from favorites" />
                <Setter Property="ToolTip" Value="Remove from favorites" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource TextButton}">
        <Setter Property="Focusable" Value="True" />
        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource OnDangerBrush}" />
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="4"
                            Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource DangerHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource OnDangerBrush}" />
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource DangerHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Surface" Property="Background" Value="{DynamicResource DangerPressedBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Surface" Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="SectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource QuickClipText12}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
        <Setter Property="Margin" Value="0,14,0,6" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource QuickClipText12}" />
        <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
        <Setter Property="Margin" Value="0,7,0,3" />
    </Style>
    <Style x:Key="Hint" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource QuickClipText12}" />
        <Setter Property="Foreground" Value="{DynamicResource SubtleText}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="CompactBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="FontSize" Value="{DynamicResource QuickClipText12}" />
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="{DynamicResource QuickClipVisual32}" />
    </Style>
    <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Focusable" Value="False" />
    </Style>

    <!-- Left navigation rail item -->
    <Style x:Key="RailItem" TargetType="RadioButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bg" Margin="6,3" Padding="0,9,0,7" CornerRadius="6" Background="Transparent">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock x:Name="Glyph" Text="{TemplateBinding Tag}" FontFamily="{StaticResource IconFont}" FontSize="{DynamicResource QuickClipVisual19}"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource SubtleText}" />
                            <ContentPresenter Margin="0,5,0,0" HorizontalAlignment="Center" TextElement.FontSize="{DynamicResource QuickClipText11}"
                                              TextElement.Foreground="{DynamicResource SubtleText}" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectionBrush}" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
