<Window x:Class="QuickClip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:QuickClip.Views"
        Title="QuickClip"
        Width="1360" Height="900" MinWidth="980" MinHeight="640"
        FontSize="{DynamicResource QuickClipText14}" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/QuickClip.ico" Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuickClip;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SaveClipAction" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                <Setter Property="MinHeight" Value="{DynamicResource QuickClipVisual36}" />
                <Setter Property="MinWidth" Value="{DynamicResource QuickClipVisual116}" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="6"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource DisabledBrush}" />
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RailColumn" Width="80" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar" Grid.ColumnSpan="2" Height="40" Visibility="Collapsed"
                Background="{DynamicResource RailBrush}">
            <DockPanel Margin="6,0,6,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Focusable" Value="True" />
                            <Setter Property="Width" Value="44" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                        </Style>
                    </StackPanel.Resources>
                    <Button x:Name="CaptionMinimize" Content="&#xE921;" Click="CaptionMinimize_Click"
                            AutomationProperties.Name="Minimize" ToolTip="Minimize" />
                    <Button x:Name="CaptionMaximize" Click="CaptionMaximize_Click"
                            AutomationProperties.Name="Maximize" ToolTip="Maximize" Content="&#xE922;" />
                    <Button Content="&#xE8BB;" Click="CaptionClose_Click" AutomationProperties.Name="Close" ToolTip="Close" />
                </StackPanel>
                <Button x:Name="CaptionMenu" DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Focusable="True" Width="34" Margin="3,0,5,0"
                        Background="Transparent" BorderBrush="Transparent" Padding="0"
                        AutomationProperties.Name="Window menu" ToolTip="Window menu (Alt+Space)" Click="CaptionMenu_Click">
                    <Image Source="Assets/QuickClip.ico" Width="19" Height="19" />
                </Button>
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           VerticalAlignment="Center" Margin="0,0,14,0" FontSize="12"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Navigation -->
        <DockPanel x:Name="Rail" Grid.Row="1" Grid.RowSpan="2" Background="{DynamicResource RailBrush}">
            <Image x:Name="RailIcon" DockPanel.Dock="Top" Source="Assets/QuickClip.ico" Width="30" Height="30" Margin="0,16,0,14" />
            <StackPanel DockPanel.Dock="Top">
                <RadioButton x:Name="GalleryNav" Style="{StaticResource RailItem}" Tag="&#xE8A9;" Content="Gallery" GroupName="Nav"
                             IsChecked="True" Checked="Nav_Checked" Click="GalleryNav_Click" ToolTip="Your clips" />
                <RadioButton x:Name="EditorNav" Style="{StaticResource RailItem}" Tag="&#xE70F;" Content="Editor" GroupName="Nav"
                             Checked="Nav_Checked" ToolTip="Trim, crop and export a clip" />
                <RadioButton x:Name="SettingsNav" Style="{StaticResource RailItem}" Tag="&#xE713;" Content="Settings" GroupName="Nav"
                             Checked="Nav_Checked" ToolTip="Recording, audio, hotkey and startup" />
            </StackPanel>
            <Grid />
        </DockPanel>

        <!-- Pages: the player and editor are created the first time they're needed and then kept (their video windows must persist) -->
        <Grid x:Name="Pages" Grid.Row="1" Grid.Column="1">
            <views:GalleryView x:Name="Gallery" />
        </Grid>

        <!-- Recording status -->
        <Border x:Name="StatusBar" Grid.Row="2" Grid.Column="1" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,7,10,7">
            <DockPanel>
                <Button x:Name="SaveClipButton" DockPanel.Dock="Right" Style="{StaticResource SaveClipAction}" Margin="12,0,0,0"
                        AutomationProperties.Name="Save clip" Click="SaveClip_Click" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="SaveActionDot" Width="10" Height="10" Fill="{DynamicResource DisabledBrush}" VerticalAlignment="Center" Margin="0,0,9,0" />
                        <TextBlock x:Name="SaveClipText" Text="Save clip" />
                    </StackPanel>
                </Button>
                <Button x:Name="UpdateButton" DockPanel.Dock="Right" Style="{StaticResource TextButton}" Margin="0,0,8,0" Padding="10,4"
                        Visibility="Collapsed" Click="UpdateButton_Click" ToolTip="A new version of QuickClip is available">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" VerticalAlignment="Center" Margin="0,0,7,0"
                                   Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                        <TextBlock x:Name="UpdateButtonText" Text="Update available" />
                    </StackPanel>
                </Button>
                <!-- Instant share: progress while the copy is made, then where it went -->
                <StackPanel x:Name="SharePanel" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,12,0"
                            Visibility="Collapsed">
                    <TextBlock x:Name="ShareIcon" FontFamily="{StaticResource IconFont}" Text="&#xE72D;" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
                    <TextBlock x:Name="ShareName" VerticalAlignment="Center" FontSize="{DynamicResource QuickClipText12.5}" FontWeight="SemiBold" MaxWidth="200"
                               TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
                    <TextBlock x:Name="ShareText" VerticalAlignment="Center" FontSize="{DynamicResource QuickClipText12.5}" />
                    <ProgressBar x:Name="ShareProgress" Width="85" Height="6" Minimum="0" Maximum="1" Margin="10,0,0,0" VerticalAlignment="Center" />
                    <Button x:Name="ShareShowButton" Style="{StaticResource TextButton}" Content="Show" Padding="9,3" Margin="8,0,0,0"
                            Click="ShareShow_Click" ToolTip="Show the copy in Explorer" />
                    <Button x:Name="ShareCloseButton" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="{DynamicResource QuickClipVisual10}" Padding="6,4" Margin="4,0,0,0"
                            Click="ShareClose_Click" />
                </StackPanel>
                <Ellipse x:Name="RecDot" DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,9,0" VerticalAlignment="Center" Fill="{DynamicResource DisabledBrush}" />
                <TextBlock x:Name="RecStatus" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontSize="{DynamicResource QuickClipText12.5}" TextTrimming="CharacterEllipsis" Text="Starting…" />
            </DockPanel>
        </Border>

        <!-- Release notes after an update -->
        <views:WhatsNewView x:Name="WhatsNew" Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed" />
    </Grid>
</Window>
