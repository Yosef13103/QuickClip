<Window x:Class="QuickClip.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:QuickClip.Views"
        Title="QuickClip"
        Width="1360" Height="900" MinWidth="980" MinHeight="640"
        FontSize="{DynamicResource QuickClipText14}" UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        Icon="Assets/QuickClip.ico" Background="{DynamicResource BackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/QuickClip;component/Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="SaveClipAction" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                <Setter Property="MinHeight" Value="{DynamicResource QuickClipVisual36}" />
                <Setter Property="MinWidth" Value="{DynamicResource QuickClipVisual116}" />
                <Setter Property="Padding" Value="14,6" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9"
                                    BorderBrush="Transparent" BorderThickness="1" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource OnAccentHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource AccentHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource DividerBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
            <!-- An available update is a distinct action, not another plain status-bar text button. -->
            <Style x:Key="UpdateAvailableAction" TargetType="Button" BasedOn="{StaticResource TextButton}">
                <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="MinHeight" Value="{DynamicResource QuickClipVisual36}" />
                <Setter Property="Padding" Value="9,5" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                    CornerRadius="9" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Surface" Property="Background" Value="{DynamicResource SelectionBrush}" />
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource PrimaryTextBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Surface" Property="Opacity" Value="0.75" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Surface" Property="Opacity" Value="0.5" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid x:Name="WindowLayout" Background="{DynamicResource BackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="RailColumn" Width="80" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border x:Name="TitleBar" Grid.ColumnSpan="2" MinHeight="40" Visibility="Collapsed"
                Background="{DynamicResource RailBrush}">
            <DockPanel Margin="6,0,6,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <StackPanel.Resources>
                        <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                            <Setter Property="Focusable" Value="True" />
                            <Setter Property="Width" Value="44" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
                        </Style>
                    </StackPanel.Resources>
                    <Button x:Name="CaptionMinimize" Content="&#xE921;" Click="CaptionMinimize_Click"
                            AutomationProperties.Name="Minimize" ToolTip="Minimize" />
                    <Button x:Name="CaptionMaximize" Click="CaptionMaximize_Click"
                            AutomationProperties.Name="Maximize" ToolTip="Maximize" Content="&#xE922;" />
                    <Button Content="&#xE8BB;" Click="CaptionClose_Click" AutomationProperties.Name="Close" ToolTip="Close" />
                </StackPanel>
                <Button x:Name="CaptionMenu" DockPanel.Dock="Left" Style="{StaticResource IconButton}"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True" Focusable="True" Margin="3,0,5,0"
                        Background="Transparent" BorderBrush="Transparent" Padding="0"
                        AutomationProperties.Name="Window menu" ToolTip="Window menu (Alt+Space)" Click="CaptionMenu_Click">
                    <Image Source="Assets/QuickClip.ico" Width="19" Height="19" />
                </Button>
                <TextBlock Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}"
                           VerticalAlignment="Center" Margin="0,0,14,0" FontSize="12"
                           TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Navigation -->
        <DockPanel x:Name="Rail" Grid.Row="1" Background="{DynamicResource RailBrush}">
            <Image x:Name="RailIcon" DockPanel.Dock="Top" Source="Assets/QuickClip.ico" Width="30" Height="30" Margin="0,16,0,14" />
            <StackPanel DockPanel.Dock="Top">
                <RadioButton x:Name="GalleryNav" Style="{StaticResource RailItem}" Tag="&#xE8A9;" Content="Gallery" GroupName="Nav"
                             IsChecked="True" Click="Nav_Click" ToolTip="Your clips" />
                <RadioButton x:Name="PlayerNav" Style="{StaticResource RailItem}" Tag="&#xE768;" Content="Player" GroupName="Nav"
                              Click="Nav_Click" ToolTip="Watch saved clips without editing" />
                 <RadioButton x:Name="EditorNav" Style="{StaticResource RailItem}" Tag="&#xE70F;" Content="Editor" GroupName="Nav"
                             Click="Nav_Click" ToolTip="Trim, crop and export a clip" />
                <RadioButton x:Name="SettingsNav" Style="{StaticResource RailItem}" Tag="&#xE713;" Content="Settings" GroupName="Nav"
                             Click="Nav_Click" ToolTip="Recording, audio, hotkey and startup" />
            </StackPanel>
            <Grid />
        </DockPanel>

        <!-- Pages: the player and editor are created the first time they're needed and then kept (their video windows must persist) -->
        <AdornerDecorator Grid.Row="1" Grid.Column="1">
            <Grid x:Name="Pages" ClipToBounds="True">
                <views:GalleryView x:Name="Gallery" />
            </Grid>
        </AdornerDecorator>

        <!-- Recording status -->
        <Border x:Name="StatusBar" Grid.Row="2" Grid.ColumnSpan="2" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,1,0,0" CornerRadius="0" Margin="0" Padding="16,8,12,8">
            <DockPanel>
                <Button x:Name="SaveClipButton" DockPanel.Dock="Right" Style="{StaticResource SaveClipAction}" Margin="12,0,0,0"
                        AutomationProperties.Name="Save clip" Click="SaveClip_Click" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="SaveActionDot" Width="10" Height="10" Fill="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="0,0,9,0" />
                        <TextBlock x:Name="SaveClipText" Text="Save clip" />
                    </StackPanel>
                </Button>
                <Button x:Name="UpdateButton" DockPanel.Dock="Right" Style="{StaticResource UpdateAvailableAction}"
                        Margin="0,0,8,0" Visibility="Collapsed" Click="UpdateButton_Click"
                        ToolTip="Open Settings → General → Updates" AutomationProperties.Name="View available QuickClip update">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="22" Height="22" CornerRadius="6" Background="{DynamicResource AccentBrush}" Margin="0,0,8,0">
                            <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE896;" FontSize="12"
                                       Foreground="{DynamicResource OnAccentBrush}" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <TextBlock x:Name="UpdateButtonText" Text="Update ready" VerticalAlignment="Center" />
                        <TextBlock FontFamily="{StaticResource IconFont}" Text="&#xE76C;" FontSize="10"
                                   Foreground="{DynamicResource SecondaryTextBrush}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </StackPanel>
                </Button>
                <Button x:Name="MediaJobsButton" DockPanel.Dock="Right" Content="Media jobs"
                        Style="{StaticResource TextButton}" Padding="9,3" Margin="8,0,0,0"
                        ToolTip="Media jobs and prepared share files" Click="MediaJobs_Click" />
                <Ellipse x:Name="RecDot" DockPanel.Dock="Left" Width="9" Height="9" Margin="0,0,9,0" VerticalAlignment="Center" Fill="{DynamicResource DisabledBrush}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="RecStatus" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" FontSize="{DynamicResource QuickClipText12.5}" TextTrimming="CharacterEllipsis" Text="Starting…" />
                    <Button x:Name="ActivityButton" Grid.Column="1" Visibility="Collapsed" Style="{StaticResource TextButton}"
                            Margin="8,0,0,0" Padding="8,3" MaxWidth="310" Click="ActivityButton_Click"
                            AutomationProperties.Name="Background activity">
                        <StackPanel>
                            <TextBlock x:Name="ActivityText" FontSize="{DynamicResource QuickClipText12.5}" TextTrimming="CharacterEllipsis" />
                            <ProgressBar x:Name="ActivityProgress" Height="3" Margin="0,4,0,0" Minimum="0" Maximum="1"
                                         Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Release notes after an update -->
        <views:WhatsNewView x:Name="WhatsNew" Grid.Row="1" Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed" />
    </Grid>
</Window>
